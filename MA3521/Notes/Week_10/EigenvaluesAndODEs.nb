Cell["\<\
If we make R smaller say R=1 we get wiggles. For R=1, C=0.5, and L=0.5\
\>", "Text",
 CellChangeTimes->{{3.9707570341876407`*^9, 3.9707570519303446`*^9}, {
  3.9707573352628183`*^9, 
  3.9707573372086954`*^9}},ExpressionUUID->"36adc497-a65d-4508-96de-\
b1c73e545531"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", 
        FractionBox["1", 
         SuperscriptBox["0.5", "2"]]}], 
       FractionBox[
        RowBox[{"-", "1"}], "0.5"]}
     }], "\[NoBreak]", ")"}]}], " ", ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"2.1", ",", 
     RowBox[{"-", "1.2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"A", ".", 
         RowBox[{"y", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Eigenvalues", "[", "A", "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.97075186984571*^9, 3.9707521699905167`*^9}, {
  3.9707522007741947`*^9, 3.9707522209465494`*^9}, {3.970755647493655*^9, 
  3.9707556898504434`*^9}, {3.970755748259468*^9, 3.9707557509013405`*^9}, {
  3.9707558235592165`*^9, 3.9707558286110897`*^9}, {3.970757023103484*^9, 
  3.9707570288875027`*^9}},
