Cell[CellGroupData[{

Cell["Circuit Problem", "Section",
 CellChangeTimes->{{3.9707522846646585`*^9, 
  3.9707523042237043`*^9}},ExpressionUUID->"c0c06049-6cd4-4ad1-aaa5-\
b0ad4134f29e"],

Cell[TextData[{
 "The matrix for our LRC circuit is\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"L", " ", "C"}]]}], 
       RowBox[{"-", 
        FractionBox["R", "L"]}]}
     }], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a8e4f013-2f4e-4b67-a9a9-45b4e464162d"],
 " \nLooking at eigenvalues and simulations.   For R=10, C=0.5, and L=0.5"
}], "Text",
 CellChangeTimes->{{3.9707570633833437`*^9, 3.970757101150439*^9}, {
  3.970757226562301*^9, 
  3.9707573252707176`*^9}},ExpressionUUID->"bb9bf09a-3cf8-495e-acc2-\
2a561b80655f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", 
        FractionBox["1", 
         SuperscriptBox["0.5", "2"]]}], 
       FractionBox[
        RowBox[{"-", "10"}], "0.5"]}
     }], "\[NoBreak]", ")"}]}], " ", ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"2.1", ",", 
     RowBox[{"-", "1.2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"A", ".", 
         RowBox[{"y", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Eigenvalues", "[", "A", "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.97075186984571*^9, 3.9707521699905167`*^9}, {
  3.9707522007741947`*^9, 3.9707522209465494`*^9}, {3.970755647493655*^9, 
  3.9707556898504434`*^9}, {3.970755748259468*^9, 3.9707557509013405`*^9}, {
  3.970757292618497*^9, 
  3.970757296097337*^9}},ExpressionUUID->"8e15d7e0-95e4-4ccd-b8c2-\
372a61090b43"],

