Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"sin", "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "j"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "j"}], "+", "1"}], ")"}], "!"}]], 
     SuperscriptBox["t", 
      RowBox[{
       RowBox[{"2", "j"}], "+", "1"}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"708f8893-ea55-42f4-bcc9-90fc45656427"]], \
