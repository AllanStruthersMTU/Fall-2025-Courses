13a5efcad11b"],

Cell[TextData[{
 "We need to know what ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"a", " ", "+", " ", 
      RowBox[{"b", " ", "\[ImaginaryI]"}]}]], "=", 
    RowBox[{
     SuperscriptBox["e", "a"], 
     SuperscriptBox["e", 
      RowBox[{"b", " ", "\[ImaginaryI]"}]]}]}], TraditionalForm]],
  ExpressionUUID->"7db9c048-a290-40d7-947f-a38c6fa199d6"],
 " means.   "
}], "Subitem",
