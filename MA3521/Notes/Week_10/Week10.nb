Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"b", " ", "\[ImaginaryI]"}]], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      FractionBox["1", 
       RowBox[{"n", "!"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"b", " ", "\[ImaginaryI]"}], ")"}], "n"]}]}], "=", 
    RowBox[{"1", "+", 
     RowBox[{"\[ImaginaryI]", " ", "b"}], "-", 
     FractionBox[
      SuperscriptBox["b", "2"], "2"], "-", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["b", "3"]}], "6"], "+", 
     FractionBox[
      SuperscriptBox["b", "4"], "24"], "+", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["b", "5"]}], "120"], "-", 
     FractionBox[
      SuperscriptBox["b", "6"], "720"], "-", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["b", "7"]}], "5040"], "+", 
     FractionBox[
      SuperscriptBox["b", "8"], "40320"], "+", 
     RowBox[{"O", "(", 
      SuperscriptBox["b", "9"], ")"}]}]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"44429ad6-5151-4fb0-b8c0-a784c9dbc9f1"]], \
