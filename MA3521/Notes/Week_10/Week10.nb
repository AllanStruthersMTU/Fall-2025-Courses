Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", "1."}], "6", "1"},
      {
       RowBox[{"-", "6"}], 
       RowBox[{"-", "2"}], "1"},
      {"1", "1", 
       RowBox[{"-", "5"}]}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "A", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";", 
  RowBox[{"TMax", "=", "3"}], ";"}], "\[IndentingNewLine]", 
