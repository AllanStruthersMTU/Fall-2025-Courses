0007367709c9"],

Cell[CellGroupData[{

Cell[TextData[{
 "We need to know how to think about complex eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{"a", "\[PlusMinus]", 
     RowBox[{"b", " ", "\[ImaginaryI]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a26c5420-776d-4c3d-afd3-fc2730b6b460"],
 ".  "
}], "Item",
