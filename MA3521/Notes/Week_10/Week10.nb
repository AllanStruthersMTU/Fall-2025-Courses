Cell[CellGroupData[{

Cell["Linear Algebra Review", "Section",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
  3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
  3.9704912896265965`*^9}, {3.9704920329499607`*^9, 
  3.9704920332932606`*^9}},ExpressionUUID->"f263ef0f-8245-4a33-ab4f-\
666230411fa9"],

Cell[TextData[{
 "We are going to learn how to write down the general solution of \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"A", " ", "y", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6499f274-f241-40be-a3a1-3b8cbc8c2063"],
 "\nfrom the eigenvalues and eigenvectors of the matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e78aa1e2-fcf9-47ae-bde8-f6f925c34375"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.970491258244348*^9, 
  3.97049146208081*^9}},ExpressionUUID->"c1e9934c-a589-4de8-b340-\
5826819f63b7"],

Cell["Just a reminder", "Text",
 CellChangeTimes->{{3.970491258244348*^9, 
  3.970491513490969*^9}},ExpressionUUID->"376d18c0-90e7-4fc2-9ec7-\
699aba0e9dd6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", 
     SubscriptBox["v", "i"]}], "=", 
    RowBox[{
     SubscriptBox["\[Lambda]", "i"], " ", 
     SubscriptBox["v", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "49b36f9d-2f03-4d95-aace-16919dbc33f7"],
 "  with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"||", 
    SubscriptBox["v", "i"], "||", 
    RowBox[{"\[NotEqual]", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "acc7a24f-baf2-479d-a757-c295d583e9fc"],
 " defines an eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91d4813c-566a-45ae-8068-3b594fe0f7e7"],
 " and associated eigenvector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a71747e6-2ae9-4b52-bc2c-a4a649cd992b"],
 ".  "
}], "Item",
 CellChangeTimes->{{3.970491258244348*^9, 
  3.970491556591919*^9}},ExpressionUUID->"1f212969-dfbc-4573-8104-\
648f344f3a7a"],

Cell["Eigenvalues and eigenvectors can be complex.  \t", "Item",
 CellChangeTimes->{{3.970491258244348*^9, 
  3.9704915606793756`*^9}},ExpressionUUID->"3f25da71-d9a7-48df-bbd3-\
e0295eeb9b9e"],

Cell[CellGroupData[{

Cell[TextData[{
 "Almost all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],ExpressionUUID->
  "8f59fc57-9f43-4f67-a1de-8cb4279ce7a9"],
 " matrices have an eigenvector basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["v", "n"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "a0c07f2a-d295-44bf-8192-27405f2f22ae"],
 ".  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["v", "1"], "|", 
      SubscriptBox["v", "2"], "|", "\[Ellipsis]", "|", 
      SubscriptBox["v", "n"]}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "ba5ffe4c-4c46-4229-a55e-5e749ce33ab4"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["V", 
      RowBox[{"-", "1"}]], ".", "A", ".", "V"}], "=", 
    RowBox[{"diag", "(", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], ",", 
      SubscriptBox["\[Lambda]", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["\[Lambda]", "n"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1af3fa86-96eb-4636-9c65-547b84dfbfde"],
 ".  This is diagonalization."
}], "Item",
 CellChangeTimes->{{3.970491258244348*^9, 3.9704917041844473`*^9}, {
  3.9704918045976796`*^9, 3.970491836037552*^9}, {3.9704919436861334`*^9, 
  3.9704920083411274`*^9}},ExpressionUUID->"268971cf-7029-4255-a499-\
a00f1e62d8c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Lambda]s", ",", "V"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "A", "]"}]}], ";", 
  RowBox[{"V", "=", 
   RowBox[{"V", "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", "\[Lambda]s", "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{
   RowBox[{"Inverse", "[", "V", "]"}], ".", "A", ".", "V"}], "]"}]}], "Input",
 CellChangeTimes->{{3.970491838447586*^9, 3.9704919273402386`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"e11f9f1c-633b-435a-bb94-21ecc633a333"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.9002676324102539`"}], ",", "0.7746852194438842`", ",", 
   RowBox[{"-", "0.1276296478273501`"}], ",", "0.03711436575896113`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.970491894641648*^9, 3.9704919277925444`*^9}},
 CellLabel->"Out[22]=",ExpressionUUID->"2851f340-364b-48b5-9157-b556261eeeff"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", "0.9002676324102536`"}], 
      RowBox[{"-", "8.881784197001252`*^-16"}], "5.551115123125783`*^-16", 
      RowBox[{"-", "5.551115123125783`*^-16"}]},
     {
      RowBox[{"-", "2.220446049250313`*^-16"}], "0.7746852194438844`", 
