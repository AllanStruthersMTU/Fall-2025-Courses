}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Linear Algebra Review and ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"A", " ", "y", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "60c57ddd-075f-40c0-8ef1-bbcc6b6846fa"]
}], "Section",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
  3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
  3.9704912896265965`*^9}},ExpressionUUID->"9db9cdec-c232-4ec0-b91b-\
6979c80a7516"],

Cell[TextData[{
 "Suppose I have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", 
     SubscriptBox["v", "1"]}], "=", 
    RowBox[{
     SubscriptBox["\[Lambda]", "1"], " ", 
     SubscriptBox["v", "1"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "04a4452e-29f2-4425-8f56-98f8405a99df"],
 "then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["y", "1"], "(", "t", ")"}], "=", 
    RowBox[{
     SubscriptBox["c", "1"], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       SubscriptBox["\[Lambda]", "1"], "t"}]], 
     SubscriptBox["v", "1"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17039b7f-8a92-4512-bbb9-4fe583f78e84"],
 " solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"A", " ", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6492255-4bd4-494b-9f79-bae97772ddf7"],
 ". "
}], "Text",
 CellChangeTimes->{{3.970492057435569*^9, 3.9704921624473424`*^9}, {
  3.970492192888133*^9, 3.970492195668457*^9}, {3.970492533359705*^9, 
  3.970492533359705*^9}},ExpressionUUID->"62c76c3b-b470-4bf9-b5f0-\
87e463d3c786"],

Cell[TextData[{
 "All the eigen-pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", 
     SubscriptBox["v", "i"]}], "=", 
    RowBox[{
     SubscriptBox["\[Lambda]", "i"], " ", 
     SubscriptBox["v", "i"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af52f39c-f0c6-424e-b745-5e85cf885fbf"],
 "give solutions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["y", "i"], "(", "t", ")"}], "=", 
    RowBox[{
     SubscriptBox["c", "i"], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], "t"}]], 
     SubscriptBox["v", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f427dbf-5f40-4055-a40f-692a51b67a14"],
 ". "
}], "Item",
 CellChangeTimes->{{3.970492057435569*^9, 3.970492239871691*^9}, {
  3.970492528680069*^9, 
  3.970492528680069*^9}},ExpressionUUID->"ba5efcfe-54f2-4377-adfb-\
1d32700d4993"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"A", " ", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec2351d0-a994-4319-bc1f-e7dd1b2b7ac7"],
 " is linear so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "t", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["c", "i"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        SubscriptBox["\[Lambda]", "i"], "t"}]], 
      SubscriptBox["v", "i"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05abf430-a95b-4916-b6c9-e50db6b54481"],
 " is an ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ccd352f-75e0-44f6-a05d-ce3996e8f9f3"],
 " parameter family of solutions."
}], "Item",
 CellChangeTimes->{{3.970492057435569*^9, 3.9704924019021654`*^9}, {
  3.9704925312766943`*^9, 
  3.9704925312766943`*^9}},ExpressionUUID->"144d52d3-4d65-46dc-ade4-\
78d60868cb5e"],

Cell[TextData[{
 "If the eigen-vectors are Linearly Independent (LI) then there are unique \
coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["c", "1"]},
       {
        SubscriptBox["c", "2"]},
       {"\[VerticalEllipsis]"},
       {
        SubscriptBox["c", "n"]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97d304ac-47f1-4a4d-83c4-f2dfb615407f"],
 " satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       SubscriptBox["c", "i"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         SubscriptBox["\[Lambda]", "i"], "0"}]], 
       SubscriptBox["v", "i"]}]}], "=", 
     SubscriptBox["y", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "964c9e1e-3d92-4480-af61-dc3cedaa3f19"],
 ". All we do is solve  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", " ", "c"}], "=", 
    SubscriptBox["y", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fefe7cbc-a31d-4bf2-b79c-d059b53ee2e6"],
 "."
}], "Item",
 CellChangeTimes->{{3.970492057435569*^9, 
  3.9704927131256495`*^9}},ExpressionUUID->"ce5f055a-b589-4270-8018-\
609b16860fac"],

Cell[TextData[{
 "Summary.  The solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"A", " ", "y"}]}], TraditionalForm]],ExpressionUUID->
  "ad3232e3-8f28-4b48-b5b7-87b156e68545"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "c6bf5d7e-fbb4-4e6d-8d40-2bfc214029a9"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "t", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["c", "i"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        SubscriptBox["\[Lambda]", "i"], "t"}]], 
      SubscriptBox["v", "i"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a22b0479-c413-4ee0-8885-f4c7a2ba51b1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", " ", "c"}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SubscriptBox["v", "1"], "|", "\[Ellipsis]", "|", 
        SubscriptBox["v", "n"]}], "]"}], "c"}], "=", 
     SubscriptBox["y", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "cbda3aa7-9845-4850-8803-944282d51f09"]
}], "Item",
 CellChangeTimes->{{3.970491258244348*^9, 3.970491556591919*^9}, {
  3.9704927228331327`*^9, 3.9704928354896603`*^9}, {3.970749355134758*^9, 
  3.970749355134758*^9}},ExpressionUUID->"d9f01479-386b-45a0-9c12-\
2c8571f9a001"],

Cell[TextData[{
 "You can rewrite a second order ODE as a first order system.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"L", " ", 
      RowBox[{"i", "'"}]}], "+", 
     RowBox[{"R", " ", "i"}], "+", 
     RowBox[{"q", "/", "C"}], "+", "12"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"ed0878a2-857b-4a43-918b-b5571e7ef5d5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"q", "'"}]}], TraditionalForm]],ExpressionUUID->
  "7cfba777-007b-4a1a-acf6-6bbbfb203673"],
 " is the same as",
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {"q"},
        {"i"}
       }], ")"}], "'"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"q", "'"}]},
        {
         RowBox[{
          RowBox[{"-", 
           FractionBox["q", 
            RowBox[{"C", " ", "L"}]]}], "-", 
          FractionBox["i", 
           RowBox[{"R", " ", "L"}]], "-", "12"}]}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {"i"},
         {
          RowBox[{
           RowBox[{"-", 
            FractionBox["q", 
             RowBox[{"C", " ", "L"}]]}], "-", 
           FractionBox["i", 
            RowBox[{"R", " ", "L"}]], "-", "12"}]}
        }], ")"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", GridBox[{
           {"0", "1"},
           {
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"C", " ", "L"}]]}], 
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"R", " ", "L"}]]}]}
          }], ")"}], 
        RowBox[{"(", GridBox[{
           {"q"},
           {"i"}
          }], ")"}]}], "+", 
       RowBox[{"(", GridBox[{
          {"0"},
          {
           RowBox[{"-", "12"}]}
         }], ")"}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "9ce48850-9277-484e-b656-25aca8dd08bb"]
}], "Item",
 CellChangeTimes->{{3.970491258244348*^9, 3.970491556591919*^9}, {
   3.9704927228331327`*^9, 3.9704928354896603`*^9}, {3.970749358665495*^9, 
