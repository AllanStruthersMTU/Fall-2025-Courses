     {
      RowBox[{"-", "7.424616477180734`*^-16"}], "2.0816681711721685`*^-16", 
      "8.326672684688674`*^-17", "0.037114365758961196`"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{3.970491894641648*^9, 3.9704919277978725`*^9}},
 CellLabel->
  "Out[23]//MatrixForm=",ExpressionUUID->"c4d27d7a-01c8-415a-afe5-\
9e9c0891f03d"]
}, Open  ]]
