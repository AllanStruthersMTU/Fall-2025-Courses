   3.969949312539919*^9},ExpressionUUID->"ad758e89-66c4-4fc9-9d03-\
76a24aa871b9"],

Cell[CellGroupData[{

Cell[TextData[{
 "2.7.4 Bernoulli: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], "+", 
     RowBox[{
      RowBox[{"p", "(", "t", ")"}], "y"}]}], "=", 
    RowBox[{
     RowBox[{"q", "(", "t", ")"}], 
     SuperscriptBox["y", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "64df8e9f-9f91-4074-9e0b-ce8c0adff94d"],
 ".  The substitution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    SuperscriptBox["y", 
     RowBox[{"1", "-", "n"}]]}], TraditionalForm]],ExpressionUUID->
  "787d789a-d63d-4c74-a83d-e78878ace529"],
 " gives a linear equation in ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]],ExpressionUUID->
  "6bcac017-3c81-403e-9b44-95b780052920"],
 "."
}], "Subitem",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
   3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
   3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
   3.9694391279316015`*^9}, {3.969439288434181*^9, 3.969439288434181*^9}, {
   3.969440773619159*^9, 3.9694407869894657`*^9}, {3.969527860545727*^9, 
   3.9695278994827976`*^9}, {3.9695279636143265`*^9, 3.969527969292019*^9}, {
   3.9695280103614845`*^9, 3.9695280103614845`*^9}, {3.9695281803152204`*^9, 
   3.9695282175536137`*^9}, {3.9698881072243156`*^9, 3.9698881220571203`*^9}, 
   3.9698884930092955`*^9, {3.9699492077554893`*^9, 3.9699492442893286`*^9}, {
   3.9699493260645814`*^9, 3.9699495373909073`*^9}, {3.970140242787854*^9, 
   3.9701402480279408`*^9}},ExpressionUUID->"4aae3a98-84c3-402a-985d-\
924fbd6878ce"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"u", "'"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "n"}], ")"}], 
     SuperscriptBox["y", 
      RowBox[{"1", "-", "n", "-", "1"}]], 
     RowBox[{"y", "'"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "n"}], ")"}], 
     SuperscriptBox["y", 
      RowBox[{"-", "n"}]], 
     RowBox[{"y", "'"}]}]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"02d942ff-3622-4fbc-858b-73194da8f9a1"]], \
"Subsubitem",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
