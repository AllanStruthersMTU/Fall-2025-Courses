   3.969440773619159*^9, 3.9694407869894657`*^9}, {3.969527860545727*^9, 
   3.9695278994827976`*^9}, {3.9695279636143265`*^9, 3.969527969292019*^9}, {
   3.9695280103614845`*^9, 3.9695280103614845`*^9}, {3.9695281803152204`*^9, 
   3.9695282175536137`*^9}, {3.9698881072243156`*^9, 3.9698881220571203`*^9}, 
   3.9698884930092955`*^9, {3.9699492077554893`*^9, 3.9699492442893286`*^9}, {
   3.9699493260645814`*^9, 3.9699495373909073`*^9}, {3.970140242787854*^9, 
   3.9701402877596426`*^9}},ExpressionUUID->"b4aad104-16e3-4ad2-9966-\
bfc127c729e2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "n"}], ")"}],
       Background->RGBColor[0.87, 0.94, 1]], 
      StyleBox[
       SuperscriptBox["y", 
        RowBox[{"-", "n"}]],
       Background->RGBColor[0.87, 0.94, 1]], 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{
      RowBox[{"p", "(", "t", ")"}], "  ", 
      StyleBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "n"}], ")"}],
       Background->RGBColor[0.87, 0.94, 1]], 
      StyleBox[
       SuperscriptBox["y", 
        RowBox[{"-", "n"}]],
       Background->RGBColor[0.87, 0.94, 1]], "y"}]}], "=", 
    RowBox[{
     RowBox[{"q", "(", "t", ")"}], 
     StyleBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "n"}], ")"}],
      Background->RGBColor[0.87, 0.94, 1]], 
     StyleBox[
      SuperscriptBox["y", 
       RowBox[{"-", "n"}]],
      Background->RGBColor[0.87, 0.94, 1]], 
     SuperscriptBox["y", "n"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37ba9884-1a24-4c1c-b909-030868d876cd"],
 "  "
}], "Subsubitem",
