Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"1", "/", "82.45"}]}], TraditionalForm]],ExpressionUUID->
  "6c99ff0a-6940-4eee-ac9b-761c5c507937"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "=", 
    RowBox[{"1", "-", "M"}]}], TraditionalForm]],ExpressionUUID->
  "4b5a7106-50fe-4b06-8005-45d73ed45435"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["r", "1"], "(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "M"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "256fe8b4-a2c2-49bb-8017-ca9f3429f502"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "2"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "E"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "c7dc0d8f-71f4-4d59-b270-a2ef684a552d"],
 " \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"x", "''"}], "=", 
      RowBox[{"   ", 
       RowBox[{"2", 
        RowBox[{"y", "'"}]}]}], "+", "x", "-", 
      FractionBox[
       RowBox[{"E", "(", 
        RowBox[{"x", "+", "M"}], ")"}], 
       SubsuperscriptBox["r", "1", "3"]], "-", 
      FractionBox[
       RowBox[{"M", "(", 
        RowBox[{"x", "-", "E"}], ")"}], 
       SubsuperscriptBox["r", "2", "3"]]},
     {
      RowBox[{"y", "''"}], "=", 
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"x", "'"}]}], "+", "y", "-", 
      FractionBox[
       RowBox[{"E", " ", "y"}], 
       SubsuperscriptBox["r", "1", "3"]], "-", 
      FractionBox[
       RowBox[{"M", " ", "y"}], 
       SubsuperscriptBox["r", "2", "3"]]}
    }], TraditionalForm]],ExpressionUUID->
  "687ab9af-186a-4cf4-bf76-4a469365a998"],
