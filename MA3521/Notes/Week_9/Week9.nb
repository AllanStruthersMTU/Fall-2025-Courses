Cell[CellGroupData[{

Cell["First order ODE: Analytical Solutions ", "Section",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380389027824`*^9}, {
  3.9694380708428564`*^9, 3.96943807545366*^9}, {3.969438204388988*^9, 
  3.9694382131542025`*^9}, {3.9694383935173025`*^9, 3.969438398666198*^9}, {
  3.969438720583945*^9, 3.969438723072337*^9}, {3.969438756028907*^9, 
  3.969438764294367*^9}, {3.969887986201888*^9, 
  3.96988800388212*^9}},ExpressionUUID->"7518c087-a6c4-47ac-84a5-\
c2f4e72ccbe4"],

Cell[CellGroupData[{

Cell[TextData[{
 "A ",
 StyleBox["separable",
  FontVariations->{"Underline"->True}],
 " scalar ODE has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{"g", "(", "t", ")"}], 
     RowBox[{"h", "(", "y", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "da8902d2-fd51-4e5e-8c30-d21f9b0082ca"],
 ".  "
}], "Item",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
   3.9694384969314632`*^9}, 
   3.9694406887869377`*^9},ExpressionUUID->"b7eba573-f5c7-47b0-9d99-\
a2db9afd19b3"],

Cell[TextData[{
 "You solved these in Calculus II by  separating variables and integrating \n\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"dy", "/", "dt"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "(", "t", ")"}], 
      RowBox[{
       RowBox[{"h", "(", "y", ")"}], " ", "\[DoubleLongRightArrow]", " ", 
       RowBox[{"\[Integral]", 
        FractionBox["dy", 
         RowBox[{"h", "(", "y", ")"}]]}]}]}], "=", 
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"g", "(", "t", ")"}], "dt"}]}], "+", "C"}]}]}], 
   TraditionalForm]], "SubitemParagraph",ExpressionUUID->
  "bde03e02-2c9a-42c4-a775-38124cd4434e"],
 " \nAn initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    SubscriptBox["y", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55f75f98-b69e-48f3-bded-53e70c178532"],
 " would let you solve for the one constant of integration. "
}], "ItemParagraph",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
  3.9694383134770784`*^9, 3.9694384674759007`*^9}, {3.969438504525423*^9, 
  3.9694386272473564`*^9}},ExpressionUUID->"bb4c48ec-a77c-4333-a392-\
91b4acf46f81"]
}, Open  ]],

Cell[TextData[{
 "A ",
 StyleBox["linear",
  FontVariations->{"Underline"->True}],
 " 1st order ODE has the standard form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "'"}], 
      RowBox[{"(", "t", ")"}]}], "+", 
     RowBox[{
      RowBox[{"p", "(", "t", ")"}], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", 
    RowBox[{"f", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "98b0d644-9f08-4023-8acf-21c1d3f1ae7e"],
 ".  Solve by computing the IF ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"v", "(", "t", ")"}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"p", "(", "\[Tau]", ")"}], "d\[Tau]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"b110ff0b-b2f6-4737-93d5-bb6a5d24c5d1"],
 " and solve the separable ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"v", " ", "y"}], ")"}], "'"}], "=", 
    RowBox[{"v", " ", "f"}]}], TraditionalForm]],ExpressionUUID->
  "3cab0b6b-3818-411c-842f-7cb225cd8160"],
 ". "
}], "Item",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
   3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
   3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
   3.9694388576279984`*^9}, 3.9694389128180475`*^9, {3.9694407637715235`*^9, 
   3.969440764546979*^9}, {3.9698880354147997`*^9, 
   3.9698880499778414`*^9}},ExpressionUUID->"87a8a16e-2451-403e-b3f7-\
4c42db25efef"],

Cell[CellGroupData[{

Cell[TextData[{
 "A 1st order ODE of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "f"}], 
       RowBox[{"\[PartialD]", "t"}]], "dt"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "f"}], 
       RowBox[{"\[PartialD]", "y"}]], "dy"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"51cba3cb-1ce8-4411-b3d6-1a6c34727eb8"],
 " is ",
 StyleBox["exact",
  FontVariations->{"Underline"->True}],
 " with general solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"t", ",", "y"}], ")"}], "=", "C"}], TraditionalForm]],
  ExpressionUUID->"d68e71ef-bfae-49ee-8a50-d110a4fdef62"],
 "."
}], "Item",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
   3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
   3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
   3.9694388576279984`*^9}, 3.9694389128180475`*^9, {3.9694407637715235`*^9, 
   3.969440764546979*^9}, {3.969527187246155*^9, 3.9695272536324863`*^9}, {
   3.9695272839730525`*^9, 3.969527291528535*^9}, {3.9695273225074344`*^9, 
   3.9695273517834735`*^9}, {3.9695277854494343`*^9, 
   3.9695277868488016`*^9}, {3.969527949911041*^9, 3.969527951828703*^9}, 
   3.969528005788452*^9, {3.9699490270483522`*^9, 
   3.969949075122753*^9}},ExpressionUUID->"4b9c08fb-9eff-4c56-9c8a-\
86b5e227859c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"M", "(", 
       RowBox[{"t", ",", "y"}], ")"}], "dt"}], "+", 
     RowBox[{
      RowBox[{"N", "(", 
       RowBox[{"t", ",", "y"}], ")"}], "dy"}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"3b5becf0-9c0f-4fbb-afed-bb9ceb58a65d"],
 " is exact  if and only if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "M"}], 
     RowBox[{"\[PartialD]", "y"}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", "N"}], 
     RowBox[{"\[PartialD]", "t"}]]}], TraditionalForm]],ExpressionUUID->
  "6eaf63e9-98f6-4538-bcfc-a71021a16d92"]
}], "Subitem",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
  3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
  3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
  3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
  3.9694391279316015`*^9}, {3.969439288434181*^9, 3.969439288434181*^9}, {
  3.969440773619159*^9, 3.9694407869894657`*^9}, {3.969527860545727*^9, 
  3.9695278994827976`*^9}, {3.9695279636143265`*^9, 3.969527969292019*^9}, {
  3.9695280103614845`*^9, 3.9695280103614845`*^9}, {3.9695281803152204`*^9, 
  3.9695282175536137`*^9}, {3.9698881072243156`*^9, 
  3.9698881220571203`*^9}},ExpressionUUID->"b9469560-329c-4f6e-9dc3-\
a568cd686436"],

Cell[TextData[{
 "To solve  compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"t", ",", "y"}], ")"}], "=", 
    RowBox[{
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"M", "(", 
        RowBox[{"t", ",", "y"}], ")"}], "dt"}]}], "+", 
     RowBox[{
      RowBox[{"h", "(", "y", ")"}], "\[DoubleLongRightArrow]", 
      FormBox[
       RowBox[{
        RowBox[{
         RowBox[{"h", "'"}], 
         RowBox[{"(", "y", ")"}]}], "=", 
        RowBox[{
         RowBox[{"N", "(", 
          RowBox[{"t", ",", "y"}], ")"}], "-", 
         RowBox[{
          FractionBox["\[PartialD]", 
           RowBox[{"\[PartialD]", "y"}]], 
          RowBox[{"[", 
           RowBox[{"\[Integral]", 
            RowBox[{
             RowBox[{"M", "(", 
              RowBox[{"t", ",", "y"}], ")"}], "dt"}]}], "]"}]}]}]}],
       TraditionalForm]}]}]}], TraditionalForm]],ExpressionUUID->
  "bd58c272-e4a1-455e-977e-b0a2d6df37c9"],
 " then integrate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "'"}], 
    RowBox[{"(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2a89b46-0237-410b-91ea-332577856ab4"],
 " and write down the general solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"t", ",", "y"}], ")"}], "=", "C", " "}], TraditionalForm]],
  ExpressionUUID->"0a0be4e0-b454-40b4-b3f9-22233d6a4b65"],
 " "
}], "Subitem",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
  3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
  3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
  3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
  3.9694391279316015`*^9}, {3.969439288434181*^9, 3.969439288434181*^9}, {
  3.969440773619159*^9, 3.9694407869894657`*^9}, {3.969527860545727*^9, 
  3.9695278994827976`*^9}, {3.9695279636143265`*^9, 3.969527969292019*^9}, {
  3.969528018027346*^9, 3.969528106901504*^9}, {3.969528224607602*^9, 
  3.9695283451603775`*^9}, {3.969528377575365*^9, 3.969528395312917*^9}, {
  3.969528704349778*^9, 3.969528706732565*^9}, {3.969888136995159*^9, 
  3.9698881464479227`*^9}, {3.969888177750548*^9, 3.9698881831215043`*^9}, {
  3.9699490875654945`*^9, 
  3.9699491508946266`*^9}},ExpressionUUID->"14208549-5f72-4925-a676-\
992c5ff96399"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2.7 Substitution.  Some ODEs look nicer in other variables.  For example\
\>", "Item",
 CellChangeTimes->{{3.9694382350763636`*^9, 3.9694382712429624`*^9}, {
   3.9694383134770784`*^9, 3.9694383318675656`*^9}, {3.969438474361555*^9, 
   3.9694384969314632`*^9}, {3.969438640535979*^9, 3.9694386683988333`*^9}, {
   3.969438708561661*^9, 3.9694387392510185`*^9}, {3.969438772204322*^9, 
   3.9694388576279984`*^9}, 3.9694389128180475`*^9, {3.9694407637715235`*^9, 
   3.969440764546979*^9}, {3.969527187246155*^9, 3.9695272536324863`*^9}, {
   3.9695272839730525`*^9, 3.969527291528535*^9}, {3.9695273225074344`*^9, 
   3.9695273517834735`*^9}, {3.9695277854494343`*^9, 
   3.9695277868488016`*^9}, {3.969527949911041*^9, 3.969527951828703*^9}, 
   3.969528005788452*^9, {3.9698884248878126`*^9, 3.9698884504654164`*^9}, {
