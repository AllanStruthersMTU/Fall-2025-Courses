12961cf91927"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u", "'"}], "+", " ", 
     RowBox[{
      StyleBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "n"}], ")"}],
       Background->RGBColor[0.87, 0.94, 1]], 
      RowBox[{"p", "(", "t", ")"}], "u"}]}], "=", 
    RowBox[{
     StyleBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "n"}], ")"}],
