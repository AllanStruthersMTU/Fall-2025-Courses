Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "\[Delta]"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.3", ",", "0.4", ",", "0.6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
