Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "6"}], "/", "100"}], ",", 
       RowBox[{"4", "/", "200"}], ",", "0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"6", "/", "100"}], ",", 
       RowBox[{
        RowBox[{"-", "7"}], "/", "200"}], ",", 
       RowBox[{"1", "/", "200"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"0.0", ",", 
