Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Gamma]"}], "}"}], "=", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"2", "/", "3"}], " ", "-", 
       RowBox[{"1", "/", "20"}]}], ",", 
