  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Beta]", ",", "\[Delta]"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "/", "100"}], ",", 
     RowBox[{"\[Gamma]", "/", "5000"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "70"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w0", ",", "m0"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"4.3", ",", "2.3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mSol", ",", "wSol"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"m", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"m", "[", "t", "]"}]}], "-", 
         RowBox[{"\[Beta]", " ", 
          RowBox[{"m", "[", "t", "]"}], "*", 
          RowBox[{"w", "[", "t", "]"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"m", "[", "0", "]"}], "==", "m0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Gamma]"}], " ", 
          RowBox[{"w", "[", "t", "]"}]}], "+", 
         RowBox[{"\[Delta]", " ", 
          RowBox[{"m", "[", "t", "]"}], "*", 
          RowBox[{"w", "[", "t", "]"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"w", "[", "0", "]"}], "==", "w0"}]}], "\[IndentingNewLine]", 
      " ", "}"}], ",", 
