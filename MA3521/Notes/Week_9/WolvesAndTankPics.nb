Cell["Our HW tank problem from week 8 was ", "Text",
 CellChangeTimes->{{3.9702223918785644`*^9, 3.9702223999480267`*^9}, {
  3.970223207272375*^9, 
  3.9702232077872334`*^9}},ExpressionUUID->"3477cd69-39c3-40de-aa1a-\
a644558cee3f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "7"}], "/", "100"}], ",", 
       RowBox[{"5", "/", "200"}], ",", "0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"7", "/", "100"}], ",", 
       RowBox[{
        RowBox[{"-", "9"}], "/", "200"}], ",", 
       RowBox[{"2", "/", "700"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"0.0", ",", 
       RowBox[{"4", "/", "200"}], ",", 
       RowBox[{
        RowBox[{"-", "4"}], "/", "700"}]}], "}"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"{", 
    RowBox[{"6", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"100", ",", "400", ",", "2100"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"A", ".", 
          RowBox[{"y", "[", "t", "]"}]}], "+", "f"}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "A", "]"}]}], "Input",
 CellChangeTimes->{{3.970222406340063*^9, 3.9702224195533795`*^9}, {
