Cell[CellGroupData[{

Cell[TextData[{
 "Review ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{
     RowBox[{"A", " ", "y"}], " ", "+", "b"}]}], TraditionalForm]],
  ExpressionUUID->"081da039-d804-4d4e-8fef-5c68c7c0d773"]
}], "Section",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
   3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
   3.9704912896265965`*^9}, 3.9710997632615623`*^9, {3.971781630857814*^9, 
   3.971781640308318*^9}},ExpressionUUID->"e5e5a7d8-23cd-40b4-ad1b-\
913e4b740ea9"],

Cell[CellGroupData[{

Cell[TextData[{
 "Write down the complementary solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["c", "i"], " ", 
      SubscriptBox["y", "i"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9d31809-36d4-4399-b247-2fdc10e8e309"],
 " satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["y", "c"], "'"}], "=", 
    RowBox[{"A", " ", 
     SubscriptBox["y", "c"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "251ec8ec-60a6-4cc9-bafd-473c7024d2c3"]
}], "ItemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.9717817305349073`*^9}, {
  3.971782074601838*^9, 3.9717820746098347`*^9}, {3.971782109487315*^9, 
  3.971782120487151*^9}},ExpressionUUID->"e2e24530-c938-41f4-9353-\
b9ce156de3f4"],

Cell[TextData[{
 "One solution when ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "edeeaf4c-ad2f-4d0b-b648-623b88aeec39"],
 " is real and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "v"}], "=", 
    RowBox[{"\[Lambda]", " ", "v"}]}], TraditionalForm]],ExpressionUUID->
  "0b5e2002-6d90-442a-9755-e2958afb7204"],
 "\n     ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"\[Lambda]", " ", "t", " "}]], "v"}], TraditionalForm]],
  ExpressionUUID->"1234b3d3-35d0-4861-9704-c33a92b8a7ea"],
 "  "
}], "SubitemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.9717817305349073`*^9}, {
  3.971782076165392*^9, 3.9717820970018315`*^9}, {3.9717821277812743`*^9, 
  3.971782185925545*^9}, {3.9717823361620092`*^9, 3.9717823414636555`*^9}, {
  3.971782387317325*^9, 
  3.9717823975877533`*^9}},ExpressionUUID->"5e617df5-0ad5-4d03-968f-\
e2515c0d4bd4"],

Cell[TextData[{
 "Two solutions when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{"a", "\[PlusMinus]", 
     RowBox[{"b", " ", "\[ImaginaryI]"}]}]}], TraditionalForm]],
  ExpressionUUID->"6f065d23-f1d7-4077-8d81-210a3343d503"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", 
     RowBox[{"(", 
      RowBox[{"p", " ", "+", " ", 
       RowBox[{"q", " ", "\[ImaginaryI]"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "+", 
       RowBox[{"b", " ", "\[ImaginaryI]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"p", " ", "+", " ", 
       RowBox[{"q", " ", "\[ImaginaryI]"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "037b0c29-99c2-490e-a9c2-856b73b8dd19"],
 "\n       ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"a", " ", "t"}]], "(", 
    RowBox[{
     RowBox[{
      RowBox[{"cos", "(", 
       RowBox[{"b", " ", "t"}], ")"}], " ", "p"}], "-", " ", 
     RowBox[{
      RowBox[{"sin", "(", 
       RowBox[{"b", " ", "t"}], ")"}], " ", "q"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"b761697d-e7ca-448b-80b7-7ee80c7045a1"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"a", " ", "t"}]], "(", 
    RowBox[{
     RowBox[{
      RowBox[{"sin", "(", 
       RowBox[{"b", " ", "t"}], ")"}], " ", "p"}], "+", " ", 
     RowBox[{
      RowBox[{"cos", "(", 
       RowBox[{"b", " ", "t"}], ")"}], " ", "q"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"57d78773-d3e9-4ed4-a20c-fab58c44e276"]
}], "SubitemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.9717817305349073`*^9}, {
  3.971782076165392*^9, 3.9717820970018315`*^9}, {3.9717821277812743`*^9, 
  3.971782330928402*^9}, {3.9717824018017864`*^9, 
  3.971782455597167*^9}},ExpressionUUID->"075a2876-742f-4dcf-ba57-\
f7fddbf1a321"],

Cell[TextData[{
 "Two solutions when ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "dbb642d3-1aee-4acf-ab7a-8984cbe58911"],
 " is repeated twice but there is only one eigenvector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "v"}], "=", 
    RowBox[{"\[Lambda]", " ", "v"}]}], TraditionalForm]],ExpressionUUID->
  "122b6dea-4db9-4e19-afd5-ec994632fa06"],
 " \n      ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"\[Lambda]", " ", "t"}]], "v"}], TraditionalForm]],
  ExpressionUUID->"5aaa62cd-961f-4756-9eb5-b24814575556"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", " ", 
     SuperscriptBox["e", 
      RowBox[{"\[Lambda]", " ", "t"}]], "v"}], "+", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"\[Lambda]", " ", "t"}]], "u", " "}]}], TraditionalForm]],
  ExpressionUUID->"a0bb5aa9-b55d-4516-af40-2516eb3b4f0a"],
 "\n where u satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "-", 
       RowBox[{"\[Lambda]", " ", "I"}]}], ")"}], "u"}], "=", "v"}], 
   TraditionalForm]],ExpressionUUID->"1fa3133a-2716-4f10-900a-0f5c0feafdb8"]
}], "SubitemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.9717817305349073`*^9}, {
  3.971782076165392*^9, 3.9717820970018315`*^9}, {3.9717821277812743`*^9, 
  3.971782330928402*^9}, {3.9717824018017864`*^9, 3.971782526103364*^9}, {
  3.9717825897834883`*^9, 
  3.9717826016826425`*^9}},ExpressionUUID->"1b03e1dc-21cd-4d81-9ff5-\
83b437033967"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Compute a particular solution ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b4af802-2c95-46d0-975e-d08f43df4add"],
 " satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["y", "p"], "'"}], "=", 
    RowBox[{
     RowBox[{"A", " ", 
      SubscriptBox["y", "p"]}], "+", "b"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "605a9e03-7766-46b5-b855-133b9d42c82f"]
}], "ItemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 
  3.9717817813400607`*^9}},ExpressionUUID->"3b6bb986-d6d1-4fc7-979c-\
7a732e1a315f"],

Cell[TextData[{
 "Guess the form (polynomial in ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d23fcf9-7251-4a2c-a519-ab632022a9ef"],
 ", exponentials ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[Omega]", " ", "t"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7170ee39-63f6-4f08-a5d1-b510caf76f0e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"sin", "(", 
    RowBox[{"\[Omega]", " ", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a75f0678-ca67-4b91-a923-8d5b341411c2"],
 ", \[Ellipsis]) for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cbdddb2f-4773-41b1-818c-d643de52da39"],
 " if you can and compute the coefficients by substituting into the ODE.  "
}], "SubitemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 
  3.97178191275593*^9}},ExpressionUUID->"b556e277-1e3a-4bbc-b29b-\
76041c94346e"],

Cell[TextData[{
 "Use variation of parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "(", "t", ")"}], 
     RowBox[{"u", "(", "t", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6580e5cd-47ab-437f-98c7-c2bebf1e4a6d"],
 " where \n   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Integral]", "t"], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"\[CapitalPhi]", "(", "\[Tau]", ")"}], 
        RowBox[{"-", "1"}]], 
       RowBox[{"b", "(", "\[Tau]", ")"}], " ", "d\[Tau]"}]}], "+", "c"}]}], 
   TraditionalForm]],ExpressionUUID->"cab86791-7acb-4a96-a49b-a981eb06b75b"],
 " \nif you can not guess the form."
}], "SubitemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.9717817845397167`*^9}, {
  3.971781915232678*^9, 3.971781928094964*^9}, {3.971782005133333*^9, 
  3.971782072161335*^9}, {3.9717826296404457`*^9, 
  3.9717826300999737`*^9}},ExpressionUUID->"0373522d-9cba-46ed-a1f2-\
e13f92dc5568"]
}, Open  ]],

Cell[TextData[{
 "Write down the general solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     SubscriptBox["y", "c"], "+", 
     SubscriptBox["y", "p"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5faab1e6-22cc-4141-86cc-209034001074"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.971781775368947*^9}, {
  3.971782632838669*^9, 
  3.9717826629562454`*^9}},ExpressionUUID->"6d35f4c6-4402-4861-a6a1-\
3089e4683fcf"],

Cell[TextData[{
 "Substitute initial conditions (if there are) to determine the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["c", "1"], ",", 
      SubscriptBox["c", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["c", "n"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40ef2a16-40c8-471a-b1c6-3024ca41a731"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9717816706169415`*^9, 3.971781775368947*^9}, {
  3.971782632838669*^9, 
  3.9717827626118994`*^9}},ExpressionUUID->"bff52b0a-4d50-4bcd-9b7f-\
d7d685c134b4"],

Cell[CellGroupData[{

Cell["Example", "Subsection",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
   3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
   3.9704912896265965`*^9}, 3.9710997632615623`*^9, {3.971781630857814*^9, 
   3.971781640308318*^9}, {3.9717827792197943`*^9, 3.971782818356186*^9}, {
   3.97178351938239*^9, 
   3.971783533270041*^9}},ExpressionUUID->"b88fc6aa-d1c4-4ac3-a3d9-\
df5e05fa8a87"],

Cell[TextData[{
 "Solving higher order constant coefficient ODEs e.g.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "''"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"x", "'"}]}], "+", "x"}], "=", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3525a72-db9a-4d44-8f02-0be349b39b5f"]
}], "Text",
 CellChangeTimes->{{3.9717828292144585`*^9, 3.9717828891994343`*^9}, {
  3.9717832075934296`*^9, 3.971783231729731*^9}, {3.9717835726980486`*^9, 
  3.9717835769205966`*^9}},ExpressionUUID->"f70c5da8-e891-4fa6-9c0e-\
f8f78bd7ab4f"],

Cell[TextData[{
 "We can convert to a system by introducing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"x", "'"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7858c7a8-7070-4c91-8475-38240fd8a720"],
 " like this\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "''"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"x", "'"}]}], "-", "x", "+", "t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc145ae9-e67e-44a7-8c45-626b07ed5df0"],
 "\nso rearranging gives\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"x", "'"}], "=", 
      RowBox[{"             ", "v", "    "}]},
     {
      RowBox[{"v", "'"}], "=", 
      RowBox[{
       RowBox[{"-", "x"}], " ", "-", 
       RowBox[{"2", "v"}], "+", "t"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d0df72e-7ac2-47da-99b7-87e127fd7f8e"],
 "\nwhich with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"(", GridBox[{
       {"x"},
       {"v"}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aefd5a1c-d608-4ab6-8e01-43ac65dc8d71"],
 " is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {"0", "1"},
         {
          RowBox[{"-", "1"}], 
          RowBox[{"-", "2"}]}
        }], ")"}], "y"}], "+", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"t"}
       }], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "60273ed9-2868-4fab-acf1-61c058f070ce"],
 "\nThe matrix has one eigen vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"-", "1"}]},
       {"1"}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ade11a48-27ac-442d-b5e2-e2ce13ce5b0e"],
 " for a repeated eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b1d41c2-b277-4778-8a46-711afdce40e2"],
 " so the complementary solution is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"-", "t"}]], "(", GridBox[{
         {
          RowBox[{"-", "1"}]},
         {"1"}
        }], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "2"], 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"-", "t"}]], "(", 
       RowBox[{
        RowBox[{"t", "(", GridBox[{
           {
            RowBox[{"-", "1"}]},
           {"1"}
          }], ")"}], "+", 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"-", "1"}]},
           {"0"}
          }], ")"}]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eaa71df0-5787-441b-aea4-59de72bf66bd"]
}], "Text",
 CellChangeTimes->{{3.9717828292144585`*^9, 3.9717831692868443`*^9}, {
  3.971783211164281*^9, 3.971783244280327*^9}, {3.9717833053625927`*^9, 
  3.9717834966547375`*^9}, {3.9717835800988965`*^9, 
  3.971783656327853*^9}},ExpressionUUID->"7754236f-e4d9-4dd8-8c71-\
64979a239efb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Eigensystem", "[", 
   RowBox[{"A", "=", 
    RowBox[{"(", GridBox[{
       {"0", "1"},
       {
        RowBox[{"-", "1"}], 
        RowBox[{"-", "2"}]}
      }], ")"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LinearSolve", "[", 
  RowBox[{
   RowBox[{"A", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9717831725494485`*^9, 3.971783195047908*^9}, {
  3.9717832504760013`*^9, 3.9717832981805887`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"6df91048-b32e-40e9-8484-d98c3f28157a"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", "1"}], 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{
  3.9717831984246902`*^9, {3.9717832510356455`*^9, 3.9717832986283236`*^9}},
 CellLabel->
  "Out[6]//MatrixForm=",ExpressionUUID->"36e1f5bf-5567-4b46-a0b1-\
bcfc2026adf6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1"}], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9717831984246902`*^9, {3.9717832510356455`*^9, 3.9717832986363153`*^9}},
 CellLabel->"Out[7]=",ExpressionUUID->"ee45dde2-472b-4221-b7b8-58ce55298dd4"]
}, Open  ]],

Cell[TextData[{
 "A particular solution is of the form\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "=", 
    RowBox[{
     SubscriptBox["u", "0"], "+", 
     RowBox[{"t", " ", 
      SubscriptBox["u", "1"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b491b89c-b786-460e-a118-b81be630c6f7"],
 "\nwhere the undetermined coefficients satisfy\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "1"], "=", 
    RowBox[{
     RowBox[{"A", "(", 
      RowBox[{
       SubscriptBox["u", "0"], "+", 
       StyleBox[
        RowBox[{"t", " ", 
         SubscriptBox["u", "1"]}],
        Background->RGBColor[1, 0.5, 0.5]]}], ")"}], "+", 
     StyleBox[
      RowBox[{"t", "(", GridBox[{
         {"0"},
         {"1"}
        }], ")"}],
      Background->RGBColor[1, 0.5, 0.5]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d998d1a0-08bf-42a6-b05c-ded51bef436e"],
 "\nMatching coefficients gives \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {"0", "=", 
      StyleBox[
       RowBox[{"A", " ", 
        SubscriptBox["u", "1"]}],
       Background->RGBColor[1, 0.5, 0.5]], "+", 
      StyleBox[
       RowBox[{"(", GridBox[{
          {"0"},
          {"1"}
         }], ")"}],
       Background->RGBColor[1, 0.5, 0.5]]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"A", " ", 
       SubscriptBox["u", "0"]}], "+", 
      RowBox[{"(", GridBox[{
         {"0"},
         {"0"}
        }], ")"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34903322-6877-45e0-8f06-e04ea95f2033"],
 "\nrewriting gives\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", GridBox[{
            {"0", "0"},
            {"0", "0"}
           }], ")"}], 
         RowBox[{"-", "A"}]},
        {
         RowBox[{"-", "A"}], 
         RowBox[{"(", GridBox[{
            {"1", "0"},
            {"0", "1"}
           }], ")"}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "0"]},
        {
         SubscriptBox["u", "1"]}
       }], ")"}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"(", GridBox[{
           {"0"},
           {"1"}
          }], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {"0"},
           {"0"}
          }], ")"}]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53219199-4195-45df-a217-5d577e083c79"],
 "\t "
}], "Text",
 CellChangeTimes->{{3.9717835427305727`*^9, 3.971783571423478*^9}, {
  3.971783677245504*^9, 3.9717839607107615`*^9}, {3.9717840014163437`*^9, 
  3.971784089286854*^9}},ExpressionUUID->"0c77e583-3af5-49c7-857b-\
23d457c07363"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LinearSolve", "[", 
  RowBox[{
   RowBox[{"ArrayFlatten", "[", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{"-", "A"}]},
       {
        RowBox[{"-", "A"}], 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}
      }], "\[NoBreak]", ")"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.971784101370288*^9, 3.9717841612591624`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"101a8c5a-8b33-44e3-b667-d754beb8c3fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "1", ",", "1", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9717841654185743`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"0ad80a6b-bcd7-4f95-8261-23be25081c57"]
}, Open  ]],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "0"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"-", "2"}]},
       {"1"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "23fbba7e-4023-41bb-878e-c699d5da3074"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "1"], "=", 
    RowBox[{"(", GridBox[{
       {"1"},
       {"0"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "973365fa-0d37-4a92-b500-f95c71f86ecd"],
 " and the general solution is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"x"},
        {"v"}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["y", "c"], "+", 
       SubscriptBox["y", "p"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["c", "1"], 
        RowBox[{
         SuperscriptBox["e", 
          RowBox[{"-", "t"}]], "(", GridBox[{
           {
            RowBox[{"-", "1"}]},
           {"1"}
          }], ")"}]}], "+", 
       RowBox[{
        SubscriptBox["c", "2"], 
        RowBox[{
         SuperscriptBox["e", 
          RowBox[{"-", "t"}]], "(", 
         RowBox[{
          RowBox[{"t", "(", GridBox[{
             {
              RowBox[{"-", "1"}]},
             {"1"}
            }], ")"}], "+", 
          RowBox[{"(", GridBox[{
             {
              RowBox[{"-", "1"}]},
             {"0"}
            }], ")"}]}], ")"}]}], "+", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"-", "2"}]},
          {"1"}
         }], ")"}], "+", 
       RowBox[{"t", "(", GridBox[{
          {"1"},
          {"0"}
         }], ")"}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "6d8a2026-2358-49c1-9db3-27bf4c92c21f"],
 "\nWe might only care about\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["c", "1"]}], 
      SuperscriptBox["e", 
       RowBox[{"-", "t"}]]}], "-", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "2"], "(", 
       RowBox[{"1", "+", "t"}], ")"}], 
      SuperscriptBox["e", 
       RowBox[{"-", "t"}]]}], "-", "2", "+", "t"}]}], TraditionalForm]],
  ExpressionUUID->"ce03d62a-34bb-4871-aaa9-87a9584d19be"],
 " \nPeople would describe this as two decaying transients and a linearly \
growing particular solution. "
}], "Text",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.971784983529536*^9, 3.971785066713973*^9}, {3.9717918001804113`*^9, 
  3.9717918032611337`*^9}},ExpressionUUID->"dd121e0b-2d10-4ba9-929d-\
c5693520c42d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Chapter 4: ", "Section",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
   3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
   3.9704912896265965`*^9}, 3.9710997632615623`*^9, {3.971781630857814*^9, 
   3.971781640308318*^9}, {3.9717827792197943`*^9, 3.971782818356186*^9}, {
   3.97178351938239*^9, 3.971783533270041*^9}, {3.9717900666853943`*^9, 
   3.971790069229156*^9}, {3.9719531953786697`*^9, 3.971953197070443*^9}, {
   3.9723754573921337`*^9, 
   3.9723754577256355`*^9}},ExpressionUUID->"b7296df1-f779-4d6f-948c-\
5a6911985db3"],

Cell[TextData[{
 "Chapter 4 describes how to solve higher order constant coefficient linear \
ODEs directly without converting them to a system!  The Chapter 4 material \
matters because it is the way lots of scientists and engineers talk about \
simple equations such as\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{"x", "''"}]}], "+", 
     RowBox[{"c", " ", 
      RowBox[{"x", "'"}]}], "+", 
     RowBox[{"k", " ", "x"}]}], "=", 
    RowBox[{
     SubscriptBox["f", "0"], 
     RowBox[{"sin", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "28efdf2a-88b0-4e26-8e32-7101ea67a8ef"],
 ". \nThis is the standard model for a mass-spring system with mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cdd1810-a8c1-45ef-87d2-4e3872c123a5"],
 ", spring constant ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a7a2df7d-4eac-4ff7-9d32-c4f1345ca32b"],
 ", and linear damping coefficient ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9407903-8e6a-4f08-b1eb-76c1f69b99ca"],
 " subject to a sinusoidal (angular frequency ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e66e603c-4ec6-4771-9829-c9ad76d02ee6"],
 ") force of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3529958e-9fe8-41b6-a667-0989eb4a31f7"],
 " Newtons.   In the real world, the damping ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f4ee5a0-c141-4eb5-9430-1ecfee18e3d4"],
 " is usually small and the angular frequency of the force could be anywhere \
from slow ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", 
    RowBox[{"<<", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a554232b-8d67-4e47-b8e3-c82fdbc284ed"],
 " to fast ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", ">>", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2290ed0d-a049-4d42-8c77-a64f90c4ac71"],
 ".  We will see for the simple model there is a single angular frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a44e7ef1-246b-4452-b947-c64e6c12fc96"],
 " near which a small force can produce an outsized response. Resonant \
responses can be disastrous.    "
}], "Text",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
  3.9717852948915715`*^9}, {3.9717853528332095`*^9, 3.971785440288228*^9}, {
  3.97178618186799*^9, 3.9717863694596863`*^9}, {3.9717864078279257`*^9, 
  3.971786545447472*^9}, {3.971791997429885*^9, 3.9717920292676687`*^9}, {
  3.9717921109559245`*^9, 
  3.9717921118999805`*^9}},ExpressionUUID->"bea2f494-f576-4145-871c-\
c8dfda2b8b98"],

Cell[CellGroupData[{

Cell[TextData[{
 "Chapter 4: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "c"], TraditionalForm]],ExpressionUUID->
  "c08222ce-f343-42a6-a5f2-0f6312996377"],
 " "
}], "Subsection",
 CellChangeTimes->{{3.9694380361627445`*^9, 3.9694380625378714`*^9}, {
   3.970491221708372*^9, 3.970491247637053*^9}, {3.9704912887519307`*^9, 
   3.9704912896265965`*^9}, 3.9710997632615623`*^9, {3.971781630857814*^9, 
   3.971781640308318*^9}, {3.9717827792197943`*^9, 3.971782818356186*^9}, {
   3.97178351938239*^9, 3.971783533270041*^9}, {3.9717900666853943`*^9, 
   3.971790069229156*^9}, {3.9719531953786697`*^9, 
   3.9719532088476195`*^9}},ExpressionUUID->"50a8071c-9327-4bc1-88e8-\
665682ad27a7"],

Cell[TextData[{
 "To find the component solutions of \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["a", "2"], 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "0"], "y"}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96a3a97e-0c5a-416a-a7c3-d823c6dcabc3"],
 "\nsimply substitute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    SuperscriptBox["e", 
     RowBox[{"\[Lambda]", " ", "t"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cddaccf4-7fb9-4326-9c8d-03455530d187"],
 " into the ODE to get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["a", "2"], 
      SuperscriptBox["\[Lambda]", "2"], 
      SuperscriptBox["e", 
       RowBox[{"\[Lambda]", " ", "t"}]]}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], "\[Lambda]", " ", 
      SuperscriptBox["e", 
       RowBox[{"\[Lambda]", " ", "t"}]]}], "+", 
     RowBox[{
      SubscriptBox["a", "0"], 
      SuperscriptBox["e", 
       RowBox[{"\[Lambda]", " ", "t"}]]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad92f293-0cca-4666-91b0-26f4585af97b"],
 "\nand cancel the exponential to get the ",
 StyleBox["characteristic",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["polynomial",
  FontVariations->{"Underline"->True}],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["a", "2"], 
      SuperscriptBox["\[Lambda]", "2"]}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], "\[Lambda]"}], " ", "+", 
     SubscriptBox["a", "0"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14ff35b3-33c3-4168-95ce-e6b9c4a0f161"],
 "\nTwo distinct roots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f56cca28-af44-4a91-9ee3-821fa065d40c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6ec1bde-7021-45b7-967d-928883297197"],
 ") of this quadratic will give the complementary solution\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], 
      SubscriptBox["y", "1"]}], "+", 
     RowBox[{
      SubscriptBox["c", "2"], 
      SubscriptBox["y", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "efee7ce8-80e1-44ce-945a-ca31126f7c43"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "1"], 
     SuperscriptBox["e", 
      RowBox[{
       SubscriptBox["\[Lambda]", "1"], "t"}]]}], "+", 
    RowBox[{
     SubscriptBox["c", "2"], 
     SuperscriptBox["e", 
      RowBox[{
       SubscriptBox["\[Lambda]", "2"], "t"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b7e2635-1e53-41f2-a4d9-ac812d674cd7"],
 "\nEuler\[CloseCurlyQuote]s identity \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", " ", "\[PlusMinus]", " ", 
        RowBox[{"\[ImaginaryI]", " ", "b"}]}], ")"}], "t"}]], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"a", " ", "t"}]], "(", 
     RowBox[{
      RowBox[{"cos", "(", 
       RowBox[{"b", " ", "t"}], ")"}], " ", "\[PlusMinus]", " ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"sin", "(", 
        RowBox[{"b", " ", "t"}], ")"}]}]}], " ", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "330d90a8-9230-4a60-932d-d87339c0ca56"],
 "\nsplits complex root pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{"a", "\[PlusMinus]", 
     RowBox[{"\[ImaginaryI]", " ", "b"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "549bbd78-64d1-4478-bd1a-4e0b9f88f904"],
 " into two independent real solutions \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"a", " ", "t"}]], 
     RowBox[{"cos", "(", 
      RowBox[{"b", " ", "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07c09749-e0ed-47a3-9f27-ba9c42d0de79"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "2"], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"a", " ", "t"}]], 
     RowBox[{"sin", "(", 
      RowBox[{"b", " ", "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1999ba95-ca13-4563-a4fc-0657e5f821d3"]
}], "Text",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
  3.9717852948915715`*^9}, {3.9717853528332095`*^9, 3.971785440288228*^9}, {
  3.97178618186799*^9, 3.9717863694596863`*^9}, {3.9717864078279257`*^9, 
  3.971786545447472*^9}, {3.971791997429885*^9, 3.9717920292676687`*^9}, {
  3.9717921109559245`*^9, 3.9717921118999805`*^9}, {3.9719532144024754`*^9, 
  3.9719538407441697`*^9}, {3.971962067164538*^9, 3.971962090288042*^9}, {
  3.9719671539048815`*^9, 
  3.971967155050029*^9}},ExpressionUUID->"fc960f7e-fa53-4303-b850-\
35c48457a679"],

Cell[TextData[{
 "For a higher order ODE\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"i", "=", "3"}], "n"], " ", 
      RowBox[{
       SubscriptBox["a", "i"], 
       SuperscriptBox["y", 
        RowBox[{"(", "i", ")"}]]}]}], "+", 
     RowBox[{
      SubscriptBox["a", "2"], 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "0"], "y"}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36e44079-3e2b-4ff5-925b-5483229ecbe2"],
 " \nn roots ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "1"], ",", 
    SubscriptBox["\[Lambda]", "2"], ",", "\[Ellipsis]", ",", " ", 
    SubscriptBox["\[Lambda]", "n"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22ff3f5a-32ae-447f-b2d6-292288ccfc35"],
 "of the characteristic polynomial would give n solutions\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "i"], "=", 
    SuperscriptBox["e", 
     SubscriptBox["\[Lambda]", 
      RowBox[{"i", " ", "t"}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2f2f6d9-176e-4369-8681-01166aea148f"],
 "\nto build the complementary solution\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["c", "i"], 
      SubscriptBox["y", "i"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "212475ef-d572-40da-a9db-1e3e47145732"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
  3.9717852948915715`*^9}, {3.9717853528332095`*^9, 3.971785440288228*^9}, {
  3.97178618186799*^9, 3.9717863694596863`*^9}, {3.9717864078279257`*^9, 
  3.971786545447472*^9}, {3.971791997429885*^9, 3.9717920292676687`*^9}, {
  3.9717921109559245`*^9, 3.9717921118999805`*^9}, {3.9719532144024754`*^9, 
  3.971953829064641*^9}, {3.9719619998786774`*^9, 3.9719620553327723`*^9}, {
  3.971962100556526*^9, 
  3.9719621997482915`*^9}},ExpressionUUID->"f1ce9942-e5e4-4eda-bdad-\
08051d724c27"],

Cell[TextData[{
 "Multiplying by t  generates needed solutions for repeated roots. If ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ed6d624-6bfd-4ff3-b026-f7b0641256e7"],
 " is repeated twice \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", 
    SuperscriptBox["e", 
     RowBox[{"\[Lambda]", " ", "t"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08916467-16bd-4daf-8819-b332257afdea"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "2"], "=", 
    RowBox[{"t", " ", 
     SuperscriptBox["e", 
      RowBox[{"\[Lambda]", " ", "t"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8182478e-d1b9-4abf-81bd-2135d2a667bd"],
 "\nare solutions.  If ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "606509fa-a862-4ec7-817f-339aaf2da111"],
 " is repeated three times then\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["y", "1"], "=", 
     SuperscriptBox["e", 
      RowBox[{"\[Lambda]", " ", "t"}]]}], ",", " ", 
    RowBox[{
     SubscriptBox["y", "2"], "=", 
     RowBox[{
      RowBox[{"t", " ", 
       SuperscriptBox["e", 
        RowBox[{"\[Lambda]", " ", "t"}]], " ", "and", " ", 
       SubscriptBox["y", "3"]}], "=", 
      RowBox[{
       SuperscriptBox["t", "2"], " ", 
       SuperscriptBox["e", 
        RowBox[{"\[Lambda]", " ", "t"}]]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "734f7e80-de93-4e5e-9ae5-92bc9d817d79"],
 "\nare solutions.  "
}], "Text",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
  3.9717852948915715`*^9}, {3.9717853528332095`*^9, 3.971785440288228*^9}, {
  3.97178618186799*^9, 3.9717863694596863`*^9}, {3.9717864078279257`*^9, 
