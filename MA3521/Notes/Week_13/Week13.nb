Cell[CellGroupData[{

Cell["Experiments", "Section",
 CellChangeTimes->{{3.9725700625405397`*^9, 
  3.9725700650115633`*^9}},ExpressionUUID->"b4712691-ca45-4892-ad4a-\
0171433a7732"],

Cell[TextData[{
 "SDOF means Single Degree of Freedom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{"c", " ", 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{"k", " ", "y"}]}], "=", " ", 
    RowBox[{
     SubscriptBox["f", "0"], 
     RowBox[{"sin", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b719253-7ecf-4e3b-b8a8-4cc43dfe2fcd"],
 "\nhttps://www.youtube.com/watch?v=LV_UuzEznHs"
}], "Text",
 CellChangeTimes->{{3.9725700678271465`*^9, 
  3.9725701146410203`*^9}},ExpressionUUID->"77b7b90a-8159-4fa4-82c7-\
06e8612a55e5"],

Cell[TextData[{
 "MDOF means Multiple Degree of Freedom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{
       OverscriptBox["y", "\[RightVector]"], "''"}]}], "+", 
     RowBox[{"C", " ", 
      RowBox[{
       OverscriptBox["y", "\[RightVector]"], "'"}]}], "+", 
     RowBox[{"K", " ", 
      OverscriptBox["y", "\[RightVector]"]}]}], "=", " ", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["f", "\[RightVector]"], "0"], 
     RowBox[{"sin", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d378ed0-47d4-423c-8b51-bf76fbd38b28"],
 "\nhttps://www.youtube.com/watch?v=OaXSmPgl1os"
}], "Text",
 CellChangeTimes->{{3.9725700678271465`*^9, 
  3.9725701915508137`*^9}},ExpressionUUID->"70103048-f97c-4d42-bb54-\
b3a4baf273b9"]
}, Open  ]],

