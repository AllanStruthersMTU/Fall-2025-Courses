Cell[TextData[{
 "Earth-Moon probe ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"1", "/", "82.45"}]}], TraditionalForm]],ExpressionUUID->
  "8a12dd7e-99f4-46d8-8e3e-286486fa93f2"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "=", 
    RowBox[{"1", "-", "M"}]}], TraditionalForm]],ExpressionUUID->
  "d1793771-9a65-4542-a9ad-d0b0940ec60f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "1"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "M"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "789a04e1-0227-4432-a979-01ccfa8ccfd2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "2"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "E"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "470aefec-61e3-40c6-aca5-fc44abbcff5e"],
 " \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"x", "''"}], "=", 
      RowBox[{"   ", 
       RowBox[{"2", 
        RowBox[{"y", "'"}]}]}], "+", "x", "-", 
      FractionBox[
       RowBox[{"E", "(", 
        RowBox[{"x", "+", "M"}], ")"}], 
       SubsuperscriptBox["r", "1", "3"]], "-", 
      FractionBox[
       RowBox[{"M", "(", 
        RowBox[{"x", "-", "E"}], ")"}], 
       SubsuperscriptBox["r", "2", "3"]]},
     {
      RowBox[{"y", "''"}], "=", 
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"x", "'"}]}], "+", "y", "-", 
      FractionBox[
       RowBox[{"E", " ", "y"}], 
       SubsuperscriptBox["r", "1", "3"]], "-", 
      FractionBox[
       RowBox[{"M", " ", "y"}], 
       SubsuperscriptBox["r", "2", "3"]]}
    }], TraditionalForm]],ExpressionUUID->
  "12e57614-3fe1-4356-a290-e13f6bcecee2"],
