  3.9719624171456547`*^9, 
  3.9719625423029985`*^9}},ExpressionUUID->"34007a18-d12b-4534-acb7-\
aaa94ebe3873"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3dfb3479-a40e-43e4-afae-d4e0984ea12e"],
 " is a sine and/or cosine guess a sum of sines and cosines  "
}], "Item",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
  3.9717852948915715`*^9}, {3.9717853528332095`*^9, 3.971785440288228*^9}, {
  3.97178618186799*^9, 3.9717863694596863`*^9}, {3.9717864078279257`*^9, 
  3.971786545447472*^9}, {3.971791997429885*^9, 3.9717920292676687`*^9}, {
  3.9717921109559245`*^9, 3.9717921118999805`*^9}, {3.9719532144024754`*^9, 
