Cell[TextData[{
 "Predator (wolf w) prey (moose m) \
https://en.wikipedia.org/wiki/Lotka%E2%80%93Volterra_equations\n",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"m", "'"}], "=", 
      RowBox[{"   ", 
       RowBox[{"\[Alpha]", " ", "m"}]}], "-", 
      RowBox[{"\[Beta]", " ", "m", " ", "w"}]},
     {
      RowBox[{"w", "'"}], "=", 
      RowBox[{
       RowBox[{"-", "\[Gamma]"}], " ", "w"}], "+", 
      RowBox[{"\[Delta]", " ", "m", " ", "w"}]}
    }], TraditionalForm]],ExpressionUUID->
