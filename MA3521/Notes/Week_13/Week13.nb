Cell[TextData[{
 "For \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["a", "2"], 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{
      SubscriptBox["a", "0"], "y"}]}], "=", "f"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf155576-ec8b-48c5-a6dc-6ec5faac8653"],
 "\nwe can guess solution forms for simple right hand sides ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "42ddfd88-c1dc-4677-b651-c1fa78cbcae4"],
 "."
}], "Text",
