Cell[CellGroupData[{

Cell[TextData[{
 "Simulation with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44749478-cfb1-4337-a299-5e821311fa3e"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{"0", " ", 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{"k", " ", "y"}]}], "=", 
    RowBox[{
     SubscriptBox["f", "0"], 
     RowBox[{"sin", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}], " "}]}], TraditionalForm]],
  ExpressionUUID->"837af763-fd08-410d-b084-273a0587fc99"]
}], "Subsection",
 CellChangeTimes->{{3.972483240347994*^9, 3.972483242179557*^9}, {
  3.972483273342511*^9, 3.9724832903510933`*^9}, {3.972558269549573*^9, 
  3.9725582782088566`*^9}},ExpressionUUID->"4555db18-8f45-4ac9-b089-\
c13a28f99765"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7690ea51-bc1a-4385-8368-582cf7e2f060"],
 " the complementary solution \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], 
      RowBox[{"cos", "(", 
       RowBox[{
        SubscriptBox["\[Omega]", "0"], " ", "t"}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "2"], " ", 
      RowBox[{"sin", "(", 
       RowBox[{
        SubscriptBox["\[Omega]", "0"], "t"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0951d02a-f3e2-4a76-9c78-f7882dbc1e3c"],
 "\t\nis undamped and the ICs are no longer \[OpenCurlyDoubleQuote]transient\
\[CloseCurlyDoubleQuote]!  "
}], "Text",
 CellChangeTimes->{{3.9724834494377785`*^9, 3.9724835062310047`*^9}, {
  3.972558405738705*^9, 3.9725584142842245`*^9}, {3.9725584770197525`*^9, 
  3.972558679423107*^9}, {3.972558801754069*^9, 
  3.972558905891591*^9}},ExpressionUUID->"27630e06-9966-4618-b16a-\
b7733f9fe227"],

