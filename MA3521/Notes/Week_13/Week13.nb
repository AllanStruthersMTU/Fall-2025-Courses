  3.9719625236503296`*^9}},ExpressionUUID->"feb3ca0c-1bc2-46c5-83a3-\
5b3737486da5"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dcf6fd3c-01e7-4337-9e34-236c9dad7331"],
 " is a polynomial guess a polynomial of the same order."
}], "Item",
 CellChangeTimes->{{3.9717841740222187`*^9, 3.9717845403068056`*^9}, {
  3.9717849906891212`*^9, 3.9717850038801136`*^9}, {3.971785071823305*^9, 
