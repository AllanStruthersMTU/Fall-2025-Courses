Cell[TextData[{
 "Write down an AM you would row reduce for the ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{
     RowBox[{"A", " ", "y"}], "+", "b"}]}], TraditionalForm]],ExpressionUUID->
  "c6aad6de-ab92-4c64-8fe0-ce0d7652dc5b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    RowBox[{"(", GridBox[{
       {"2"},
       {"3"},
       {"4"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "fe2ff3e9-0451-43d2-ad74-4460dc2f6418"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"3", "+", 
         RowBox[{"cos", "(", "t", ")"}]}]},
       {
        RowBox[{"5", "+", 
         RowBox[{"sin", "(", "t", ")"}]}]},
       {
        RowBox[{"6", "+", "t"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a44d285e-8b9e-4bb6-b0c1-d90282717552"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "c"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"2", "t"}]], "(", GridBox[{
         {
          RowBox[{"-", "3"}]},
         {"1"},
         {"2"}
        }], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "2"], 
      RowBox[{
       SuperscriptBox["e", "t"], "(", 
       RowBox[{
        RowBox[{
         RowBox[{"cos", "(", 
          RowBox[{"2", "t"}], ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
            {"1"},
            {"1"}
           }], ")"}]}], "-", 
        RowBox[{
         RowBox[{"sin", "(", 
          RowBox[{"2", "t"}], ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
            {"1"},
            {
             RowBox[{"-", "2"}]}
           }], ")"}]}]}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "3"], 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"2", "t"}]], "(", 
       RowBox[{
        RowBox[{
         RowBox[{"sin", "(", 
          RowBox[{"2", "t"}], ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
            {"1"},
            {"1"}
           }], ")"}]}], "+", 
        RowBox[{
         RowBox[{"cos", "(", 
          RowBox[{"2", "t"}], ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
            {"1"},
            {
             RowBox[{"-", "2"}]}
           }], ")"}]}]}], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "1a9fd265-99fc-4d78-b129-732bac7ccab9"],
