Cell[TextData[{
 "An AM for the linear system  ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       SubscriptBox["A", "11"], 
       SubscriptBox["c", "1"]}], "+", 
      RowBox[{
       SubscriptBox["A", "12"], 
       SubscriptBox["c", "2"]}], "=", 
      SubscriptBox["b", "1"]},
     {
      RowBox[{
       SubscriptBox["A", "21"], 
       SubscriptBox["c", "1"]}], "+", 
      RowBox[{
       SubscriptBox["A", "22"], 
       SubscriptBox["c", "2"]}], "=", 
      SubscriptBox["b", "2"]}
