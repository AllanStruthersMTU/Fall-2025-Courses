Cell[TextData[{
 "The matrix for the linear system ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["c", "i"], 
      SubscriptBox["v", "i"]}]}], "=", 
    SubscriptBox["b", "i"]}], TraditionalForm]],ExpressionUUID->
  "54c12772-31e6-46f2-b0da-a75f65f28d76"],
 " is ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{"A", ".", GridBox[{
        {"c", "=", "b"}
       }]}], TraditionalForm]],ExpressionUUID->
    "aa45ceba-86ab-472e-a791-d1e81c7ee2a7"]], "Item",ExpressionUUID->
    "420080ef-1b0c-4580-bddf-1c5b9451f2a6"], TraditionalForm]],ExpressionUUID->
  "b92d9d7a-0a00-4c90-ad07-20a87ebdab01"],
 "  where the columns of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["v", "1"], "\[Ellipsis]", 
        SubscriptBox["v", "n"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b4f9a76a-c56c-42a5-9aa7-9b58cdb24642"],
 " are the vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "1"], TraditionalForm]],ExpressionUUID->
  "e55d51d7-d4a3-4cfc-ae4a-c2dcb72d28f6"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "2"], TraditionalForm]],ExpressionUUID->
  "71bf0b7a-635d-46ea-a64c-19aefe3e16b5"],
 ", \[Ellipsis] and an AM is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"A", "|", "b"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "16dd3cc7-1a56-452d-80a5-0d7450e463fa"],
 "."
}], "Subsubitem",
 CellChangeTimes->{{3.9689252050506372`*^9, 3.9689253372326636`*^9}, {
