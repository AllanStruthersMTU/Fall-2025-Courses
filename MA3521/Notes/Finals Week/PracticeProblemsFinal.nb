Cell[TextData[{
 "Solve the ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "(", "t", ")"}]}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"y", "(", "t", ")"}]}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"-", "13"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "t"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.9715199709488883`*^9, 3.971519991306565*^9}, {
