  FormBox[
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["A", "11"], 
       SubscriptBox["A", "12"], "|", 
       SubscriptBox["b", "1"]},
      {
       SubscriptBox["A", "21"], 
       SubscriptBox["A", "22"], "|", 
       SubscriptBox["b", "2"]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "4e67fea6-e25c-4f71-abbc-a72f910d81f9"],
 "."
