Cell[TextData[{
 "An AM for the linear system  ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       SubscriptBox["A", "11"], 
       SubscriptBox["c", "1"]}], "+", 
      RowBox[{
       SubscriptBox["A", "12"], 
       SubscriptBox["c", "2"]}], "=", 
      SubscriptBox["b", "1"]},
     {
      RowBox[{
       SubscriptBox["A", "21"], 
       SubscriptBox["c", "1"]}], "+", 
      RowBox[{
       SubscriptBox["A", "22"], 
       SubscriptBox["c", "2"]}], "=", 
      SubscriptBox["b", "2"]}
    }], TraditionalForm]],ExpressionUUID->
  "f7da2627-3e2b-4b36-86f1-e7eae683406b"],
 "  is  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["A", "11"], 
       SubscriptBox["A", "12"], "|", 
       SubscriptBox["b", "1"]},
      {
       SubscriptBox["A", "21"], 
       SubscriptBox["A", "22"], "|", 
       SubscriptBox["b", "2"]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "4e67fea6-e25c-4f71-abbc-a72f910d81f9"],
 "."
}], "Subsubitem",
