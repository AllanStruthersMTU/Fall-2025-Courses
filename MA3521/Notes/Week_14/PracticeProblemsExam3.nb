       RowBox[{
        RowBox[{
         RowBox[{"sin", "(", "t", ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
            {"1"},
            {"0"}
           }], ")"}]}], "+", 
        RowBox[{
         RowBox[{"cos", "(", "t", ")"}], 
         RowBox[{"(", GridBox[{
            {"1"},
