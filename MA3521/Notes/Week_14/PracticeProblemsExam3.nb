  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"3", "+", 
         RowBox[{"cos", "(", "t", ")"}]}]},
       {
        RowBox[{"5", "+", 
         RowBox[{"sin", "(", "t", ")"}]}]},
       {
        RowBox[{"6", "+", "t"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a44d285e-8b9e-4bb6-b0c1-d90282717552"],
