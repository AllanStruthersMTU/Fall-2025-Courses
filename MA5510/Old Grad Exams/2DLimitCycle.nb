  3.971269692179388*^9, {3.9712697436303387`*^9, 3.9712697737421155`*^9}, 
   3.9712701860059676`*^9, {3.971270271010707*^9, 3.971270290376142*^9}, {
   3.971270395251795*^9, 3.9712704221758146`*^9}, {3.971437334700741*^9, 
   3.971437361017185*^9}, 3.9714374135388465`*^9, 3.9714374448381104`*^9, 
