Notebook[{
Cell[TextData[{
 "This is the 2D problem we showed had a limit cycle using the Lyapunov \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff263929-a588-4e0f-a4e0-dfa5e2f3bf89"],
 " and the linearization about the origin.  The limit cycle is pretty \
obvious. "
}], "Text",
 CellChangeTimes->{{3.9714362399967976`*^9, 3.971436329221166*^9}, {
  3.971436402446692*^9, 
  3.9714364170369835`*^9}},ExpressionUUID->"4f7ed950-2ffb-4129-9e70-\
da3ad4619e0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "-", "y", "-", 
     RowBox[{"x", "^", "3"}]}], ",", 
    RowBox[{"x", "+", "y", "-", 
     RowBox[{"y", "^", "3"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Df", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "2"]}]}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"1", "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["y", "2"]}]}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", 
   SuperscriptBox["y", "2"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "24"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zSol1", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"f", "[", 
         RowBox[{"z", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"z", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "0.02"}], "}"}]}]}], "}"}], ",", "z", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zSol2", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"f", "[", 
         RowBox[{"z", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"z", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"12", ",", 
          RowBox[{"-", "4"}]}], "}"}]}]}], "}"}], ",", "z", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
