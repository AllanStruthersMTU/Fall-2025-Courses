c1a3f9cb03f7"],

Cell["\<\
p is the target polynomial.  g is the simple starting polynomial.  I chose \
one of the complex roots.  \
\>", "Text",
 CellChangeTimes->{{3.974043174517657*^9, 
  3.9740432404285736`*^9}},ExpressionUUID->"0298bc3d-6f52-456c-93a8-\
83c6ed413e9f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"p", ",", "g", ",", "Dp", ",", "z1", ",", "z2"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"{", 
    RowBox[{"z1_", ",", "z2_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"z2", "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["z1", "2"]}], "+", 
     SuperscriptBox["z2", "2"]}], ",", 
    RowBox[{"2", "-", 
     RowBox[{"2", " ", "z2"}], "-", "z1", "+", " ", 
     RowBox[{"2", " ", 
      SuperscriptBox["z1", "2"]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"{", 
    RowBox[{"z1_", ",", "z2_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"1", "-", 
     SuperscriptBox["z1", "2"]}], ",", 
    RowBox[{"1", "-", 
     SuperscriptBox["z2", "2"]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dp", "[", 
   RowBox[{"{", 
    RowBox[{"z1_", ",", "z2_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "z1"}], ",", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "z2"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"4", " ", "z1"}]}], ",", 
      RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dg", "[", 
   RowBox[{"{", 
    RowBox[{"z1_", ",", "z2_"}], "}"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "z1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"2", "z2"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tTarget", "=", 
   RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", 
  RowBox[{"RamData", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "tTarget"}], ")"}], 
          RowBox[{"p", "[", 
           RowBox[{"{", 
            RowBox[{"z1", ",", "z2"}], "}"}], "]"}]}], "+", 
         RowBox[{"tTarget", " ", "\[Gamma]", " ", 
          RowBox[{"g", "[", 
           RowBox[{"{", 
            RowBox[{"z1", ",", "z2"}], "}"}], "]"}]}]}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "tTarget"}], ")"}], 
           RowBox[{"Dp", "[", 
            RowBox[{"{", 
             RowBox[{"z1", ",", "z2"}], "}"}], "]"}]}], "+", 
          RowBox[{"tTarget", " ", "\[Gamma]", " ", 
           RowBox[{"Dg", "[", 
            RowBox[{"{", 
             RowBox[{"z1", ",", "z2"}], "}"}], "]"}]}]}], "]"}], "==", 
        "0"}]}], "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z1", ",", "z2", ",", "\[Gamma]"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9739430453381042`*^9, 3.9739434301469684`*^9}, {
   3.9739435351240273`*^9, 3.973943629228402*^9}, {3.973943686779024*^9, 
