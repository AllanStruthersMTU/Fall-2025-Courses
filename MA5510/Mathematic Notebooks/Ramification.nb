  FormBox[
   RowBox[{"\[Gamma]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b504cc63-263c-4ecc-a374-695200e51367"],
 " are approximately ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1.04", "\[ImplicitPlus]", " ", 
     RowBox[{"\[PlusMinus]", " ", "0.11"}]}], " ", "\[ImaginaryI]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f2bdba7-c3f9-4a64-9baf-eba6ed03541d"],
 ".  "
}], "Text",
