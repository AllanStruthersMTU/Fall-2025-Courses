          RowBox[{
           RowBox[{"f", "[", "p", "]"}], "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", "3", 
          "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<Direction\>\"", "->", 
         RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<EventAction\>\"", ":>", 
         RowBox[{"(", 
          RowBox[{"PData", "=", 
           RowBox[{"{", 
            RowBox[{"PData", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"y", "[", "t", "]"}], ",", 
               RowBox[{"J", "[", "t", "]"}]}], "}"}]}], "}"}]}], ")"}]}]}], 
       "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PData", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", "PData", "]"}], ",", 
     RowBox[{"3", "+", 
      SuperscriptBox["3", "2"]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"yJs", "=", 
       RowBox[{
       "PData", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"ys", "=", 
       RowBox[{"yJs", "\[LeftDoubleBracket]", 
        RowBox[{"1", ";;", "3"}], "\[RightDoubleBracket]"}]}], ";", " ", 
      RowBox[{"Js", "=", 
       RowBox[{"yJs", "\[LeftDoubleBracket]", 
