Cell[CellGroupData[{

Cell["StepRoundSection", "Subsubsection",
 CellChangeTimes->{{3.972634414711345*^9, 3.9726344186081934`*^9}, {
   3.972634731023261*^9, 3.9726347318830953`*^9}, {3.9726348744387417`*^9, 
   3.9726348769000177`*^9}, {3.9726354835323153`*^9, 
   3.9726355026086392`*^9}, {3.9726368787787247`*^9, 
   3.9726368840714455`*^9}, {3.9726369175518146`*^9, 3.9726369305448766`*^9}, 
   3.972637200577835*^9},ExpressionUUID->"9a9e5f9a-a289-4b90-ae01-\
ea2da40a034e"],

Cell["\<\
Once we have found a limit cycle we need to make the solver step round the \
limit cycle until it gets back to the same point and save a list of crossing \
points and sensitivities?  I do not think we have any idea right now about \
how close a return point needs to be:  we decided to call the return \
tolerance \[OpenCurlyDoubleQuote]DyTol\[CloseCurlyDoubleQuote].  For safety \
we need to make a maximum number of loops: we decided to call that MaxCounts. \
It needs to take as input the function, the sensitivity function, and the \
initial point.  I think we decided it should return a list of counts, times, \
points, and sensitivities.   \
\>", "Text",
 CellChangeTimes->{{3.972635548228905*^9, 3.972635856563277*^9}, {
  3.9726359902524157`*^9, 3.972636041229641*^9}, {3.9726367477641163`*^9, 
  3.9726367864980054`*^9}, {3.9726369361248713`*^9, 3.972636966228427*^9}, {
  3.972637204820759*^9, 3.9726373099181423`*^9}, {3.9726373544030614`*^9, 
  3.9726376346504683`*^9}},ExpressionUUID->"2a240656-59d8-4ac8-b64c-\
67b0cc2e8f2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StepRoundSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "y0_", ",", "DyTol_", ",", " ", 
    "MaxCounts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "0"}], ",", "y", ",", "J", ",", "t", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "4"]}], ",", "yOut", ",", 
      RowBox[{"tOut", "=", "0.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
         "\[IndentingNewLine]", "}"}], ",", "y", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Event\>\"", ":>", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", 
             "3", "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Direction\>\"", "->", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<EventAction\>\"", ":>", 
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sow", "[", 
