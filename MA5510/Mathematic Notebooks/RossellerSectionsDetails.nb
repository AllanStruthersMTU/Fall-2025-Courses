         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"df", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<Event\>\"", ":>", 
