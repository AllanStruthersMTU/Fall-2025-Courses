   3.9726367356786413`*^9}, {3.972636793143036*^9, 3.9726368280568166`*^9}, 
   3.972650337394185*^9},
 CellLabel->"In[58]:=",ExpressionUUID->"fc5bf818-2a66-47ce-ae2b-072fdf9afcad"],

