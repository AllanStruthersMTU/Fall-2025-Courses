Cell["\<\
Making it stop after \
\[OpenCurlyDoubleQuote]SetUpCount\[CloseCurlyDoubleQuote] crossings of \
standard section \[OpenCurlyDoubleQuote]z\[CloseCurlyDoubleQuote] at max.
Input: f as a suitable function, t0 IC 3-vector and and SetUpCount.  
Output: list of counter, end time, and final crossing point 3-vector.
I am not going to bother \
\[OpenCurlyDoubleQuote]typing\[CloseCurlyDoubleQuote] the variables. \
\>", "Text",
 CellChangeTimes->{{3.972635548228905*^9, 3.972635856563277*^9}, {
  3.9726359902524157`*^9, 3.972636041229641*^9}, {3.9726367477641163`*^9, 
  3.9726367864980054`*^9}, {3.972636980511733*^9, 
  3.972637006360875*^9}},ExpressionUUID->"40b15ec2-4080-468d-ab1d-\
2b6bfe491c51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetUpSection", "[", 
   RowBox[{"f_", ",", "y0_", ",", "SetUpCount_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "0"}], ",", "y", ",", "t", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "4"]}], ",", "yOut", ",", 
      RowBox[{"tOut", "=", "0.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "\[IndentingNewLine]",
         "}"}], ",", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Event\>\"", ":>", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", "3",
             "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Direction\>\"", "->", 
           RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<EventAction\>\"", ":>", 
           RowBox[{"(", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"n", "++"}], ">", "SetUpCount"}], ",", 
              RowBox[{
               RowBox[{"tOut", "=", "t"}], ";", 
               RowBox[{"yOut", "=", 
                RowBox[{"y", "[", "t", "]"}]}], ";", 
               "\"\<StopIntegration\>\""}]}], "]"}], "\[IndentingNewLine]", 
            ")"}]}]}], "\[IndentingNewLine]", "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "tOut", ",", "yOut"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.972635710483451*^9, 3.9726357307654476`*^9}, {
   3.9726357628839808`*^9, 3.9726357824494023`*^9}, {3.9726358667917747`*^9, 
