Cell[CellGroupData[{

Cell["StepRoundSection", "Subsubsection",
 CellChangeTimes->{{3.972634414711345*^9, 3.9726344186081934`*^9}, {
   3.972634731023261*^9, 3.9726347318830953`*^9}, {3.9726348744387417`*^9, 
   3.9726348769000177`*^9}, {3.9726354835323153`*^9, 
   3.9726355026086392`*^9}, {3.9726368787787247`*^9, 
   3.9726368840714455`*^9}, {3.9726369175518146`*^9, 3.9726369305448766`*^9}, 
   3.972637200577835*^9},ExpressionUUID->"9a9e5f9a-a289-4b90-ae01-\
ea2da40a034e"],

Cell["\<\
Once we have found a limit cycle we need to make the solver step round the \
limit cycle until it gets back to the same point and save a list of crossing \
points and sensitivities?  I do not think we have any idea right now about \
how close a return point needs to be:  we decided to call the return \
tolerance \[OpenCurlyDoubleQuote]DyTol\[CloseCurlyDoubleQuote].  For safety \
we need to make a maximum number of loops: we decided to call that MaxCounts. \
It needs to take as input the function, the sensitivity function, and the \
initial point.  I think we decided it should return a list of counts, times, \
points, and sensitivities.   \
\>", "Text",
 CellChangeTimes->{{3.972635548228905*^9, 3.972635856563277*^9}, {
  3.9726359902524157`*^9, 3.972636041229641*^9}, {3.9726367477641163`*^9, 
  3.9726367864980054`*^9}, {3.9726369361248713`*^9, 3.972636966228427*^9}, {
  3.972637204820759*^9, 3.9726373099181423`*^9}, {3.9726373544030614`*^9, 
  3.9726376346504683`*^9}},ExpressionUUID->"2a240656-59d8-4ac8-b64c-\
67b0cc2e8f2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StepRoundSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "y0_", ",", "DyTol_", ",", " ", 
    "MaxCounts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "0"}], ",", "y", ",", "J", ",", "t", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "4"]}], ",", "yOut", ",", 
      RowBox[{"tOut", "=", "0.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
         "\[IndentingNewLine]", "}"}], ",", "y", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Event\>\"", ":>", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", 
             "3", "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Direction\>\"", "->", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<EventAction\>\"", ":>", 
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sow", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "++"}], ",", "t", ",", 
                 RowBox[{"y", "[", "t", "]"}], ",", 
                 RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"Or", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"y", "[", "t", "]"}], "-", "y0"}], "]"}], "<", 
                   "DyTol"}], ",", " ", 
                  RowBox[{"n", ">", "MaxCounts"}]}], "]"}], ",", 
                "\"\<StopIntegration\>\""}], "]"}]}], "\[IndentingNewLine]", 
             ")"}]}]}], "\[IndentingNewLine]", "}"}]}]}], "]"}], "]"}], 
     "\[LeftDoubleBracket]", 
     RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.972635710483451*^9, 3.9726357307654476`*^9}, {
   3.9726357628839808`*^9, 3.9726357824494023`*^9}, {3.9726358667917747`*^9, 
   3.9726358872660165`*^9}, {3.972635920908736*^9, 3.9726359803323197`*^9}, {
   3.9726360468622055`*^9, 3.9726361570424643`*^9}, {3.9726362548185186`*^9, 
   3.97263640607269*^9}, {3.9726364378306575`*^9, 3.972636439505865*^9}, {
   3.9726364798518467`*^9, 3.972636553411805*^9}, {3.9726366417514215`*^9, 
   3.9726366453615513`*^9}, 3.9726366813257113`*^9, {3.9726367133654413`*^9, 
   3.9726367356786413`*^9}, {3.972636793143036*^9, 3.9726368280568166`*^9}, {
   3.972637698671409*^9, 3.9726378182586503`*^9}, {3.9726379766041627`*^9, 
   3.9726380064974146`*^9}, {3.9726381700090203`*^9, 3.972638196638151*^9}, {
   3.9726382607387333`*^9, 3.972638260998451*^9}, {3.972652762059552*^9, 
   3.9726527763834553`*^9}, {3.972652847775054*^9, 3.9726528766747494`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"0511384b-27a4-49c0-94d8-cbccf658838b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
