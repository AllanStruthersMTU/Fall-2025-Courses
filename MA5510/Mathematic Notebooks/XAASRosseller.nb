Cell[TextData[{
 "We can think about the mapping from the starting point to the end point of \
the twice round solve as \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "->", 
    RowBox[{"F", "(", "p", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "056a119f-6dea-4eab-bafa-74f83048ddc2"],
 ".\nTo compute the winding number two orbit we want to find a solution of\n\t\
",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"F", "(", "p", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af79386a-a91d-466a-ac6a-6263f8deaa9f"],
 ".\nWe have an approximate solution \n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "0"], "\[TildeTilde]", 
    RowBox[{"F", "(", 
     SubscriptBox["y", "0"], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc3cfdef-005d-4f8a-bfd5-2a947bb60507"],
 " \n and we have the sensitivity  \n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{"DF", "(", 
    SubscriptBox["y", "0"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d3547f7-f042-431d-9cf8-8803f897c4ab"],
 ".\n The linearization \n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "p", ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"F", "(", 
      SubscriptBox["y", "0"], ")"}], "+", 
     RowBox[{
      RowBox[{"DF", "(", 
       SubscriptBox["y", "0"], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"p", "-", 
        SubscriptBox["y", "0"]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fcb4da1c-ebc6-4aad-9916-58fb8b690126"],
 "\nshould be good for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[TildeTilde]", 
    SubscriptBox["y", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "005dc0e1-3d2f-4cd9-a383-d7725419eb30"],
 ". The Newton update ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ce2e17b-cdbe-4ea1-ac37-c486f94ac440"],
 " satisfies the linear approximation\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", 
    RowBox[{
     RowBox[{"F", "(", 
      SubscriptBox["y", "0"], ")"}], "-", 
     RowBox[{
      RowBox[{"DF", "(", 
       SubscriptBox["y", "0"], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["y", "1"], "-", 
        SubscriptBox["y", "0"]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c3ff26e-5fa7-4d2e-a854-3a3dee83c647"],
 "\n Rearranging gives\n \t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", "+", 
         RowBox[{"DF", "(", 
          SubscriptBox["y", "0"], ")"}]}], ")"}], ".", 
       SubscriptBox["y", "1"]}], "=", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["y", "0"], ")"}], "-", 
       RowBox[{
        RowBox[{"DF", "(", 
         SubscriptBox["y", "0"], ")"}], ".", 
        SubscriptBox["y", "0"]}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af2d2cd2-d402-46e4-bfc4-120c4c2b1896"],
 "\n which can be solved to give\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", 
    RowBox[{"LinearSolve", "[", "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5d33099-e6b5-4517-8c03-3394ccd01640"],
 "\n You should have some concerns about the linear solve here."
}], "Text",
 CellChangeTimes->{{3.972994971468795*^9, 3.9729957691449213`*^9}, {
  3.972998249426585*^9, 3.9729984837678294`*^9}, {3.9729994576264873`*^9, 
  3.972999776530905*^9}},ExpressionUUID->"0e67c7d1-f14b-4725-984a-\
9b8255f68493"],

