Cell[CellGroupData[{

Cell["Variable Step Size.", "Subsection",
 CellChangeTimes->{{3.970822568374402*^9, 3.97082257775103*^9}, {
  3.970822676225294*^9, 
  3.970822677775757*^9}},ExpressionUUID->"d549c6d7-b063-4512-aa93-\
cc7384289cc4"],

Cell["\<\
Adaptive step size with local error control was a huge improvement \
\>", "Text",
 CellChangeTimes->{{3.9708226953690047`*^9, 
  3.9708227295609016`*^9}},ExpressionUUID->"eb5bafef-0d14-4e03-b18b-\
7e76cb031d24"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExplicitRKAdaptiveStep", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"A_", ",", "bHigh_", ",", "bLow_", ",", "LowOrder_"}], "}"}], 
     ",", "AbsTol_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"t_", ",", "y_", ",", "h_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"s", "=", 
       RowBox[{"Length", "[", "bHigh", "]"}]}], ",", "yHigh", ",", "yLow", 
      ",", "Err", ",", 
      RowBox[{"\[Gamma]", "=", "0.9"}], ",", "\[Alpha]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "[", "1", "]"}], "=", 
      RowBox[{"f", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "i", "]"}], "=", 
        RowBox[{"f", "[", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], " ", 
              RowBox[{"k", "[", "j", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "s"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yHigh", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "bHigh", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yLow", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "bLow", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Error", " ", "\[TildeTilde]"}], "||", 
        RowBox[{"yHigh", "-", "yLow"}], "||"}], "=", 
       RowBox[{"C", " ", 
        SuperscriptBox["h", 
         RowBox[{"LowOrder", "+", "1"}]]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Err", "=", 
      RowBox[{"Norm", "[", 
       RowBox[{"yHigh", "-", "yLow"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"\[Gamma]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["AbsTol", "Err"], ")"}], 
        FractionBox["1", 
         RowBox[{"LowOrder", "+", "1"}]]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"if", " ", "Err"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"C", " ", 
         SuperscriptBox["h", 
          RowBox[{"p", "+", "1"}]], " ", "then", " ", "C", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Alpha]", " ", "h"}], ")"}], 
          RowBox[{"p", "+", "1"}]]}], "=", " ", 
        RowBox[{"AbsTol", " ", "if", " ", Cell[TextData[{
          "\[Alpha] = ",
          Cell[BoxData[
           FormBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"AbsTol", "/", "Err"}], ")"}], 
             FractionBox["1", 
              RowBox[{"p", "+", "1"}]]], TraditionalForm]],
           FormatType->TraditionalForm,ExpressionUUID->
           "2ba9b07a-6ea3-4fe2-a4bb-dd70ea931574"]
         }],ExpressionUUID->"52a8338f-b521-443a-87bf-b37871fb2dae"]}]}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"(", 
        RowBox[{"frequently", " ", "0.9"}], ")"}], " ", "is", " ", "a", " ", 
       "safety", " ", 
       RowBox[{"factor", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "If", " ", Cell[
       "Err < AbsTol",ExpressionUUID->"4e1dcea1-01ee-43b7-b3f2-4c41bcc65bf3"],
        " ", "take", " ", "step", " ", "and", " ", "estimate", " ", "how", 
       " ", "big", " ", "the", " ", "next", " ", "step", " ", "can", " ", 
       "be"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "If", " ", Cell[
       "Err > AbsTol",ExpressionUUID->"c3d0309a-4e05-40fa-b0c3-9177236f2e97"],
        " ", "skip", " ", "step", " ", "and", " ", "try", " ", "again", " ", 
       "with", " ", "a", " ", "smaller", " ", "step"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"Err", "<", "AbsTol"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "+", "h"}], ",", " ", "yHigh", ",", 
         RowBox[{"\[Alpha]", " ", "h"}]}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "y", ",", 
         RowBox[{"\[Alpha]", " ", "h"}]}], " ", "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
