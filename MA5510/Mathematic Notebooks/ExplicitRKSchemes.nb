Cell[CellGroupData[{

Cell["Variable Step Size.", "Subsection",
 CellChangeTimes->{{3.970822568374402*^9, 3.97082257775103*^9}, {
  3.970822676225294*^9, 
  3.970822677775757*^9}},ExpressionUUID->"d549c6d7-b063-4512-aa93-\
cc7384289cc4"],

Cell["\<\
Adaptive step size with local error control was a huge improvement \
\>", "Text",
 CellChangeTimes->{{3.9708226953690047`*^9, 
  3.9708227295609016`*^9}},ExpressionUUID->"eb5bafef-0d14-4e03-b18b-\
7e76cb031d24"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExplicitRKAdaptiveStep", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"A_", ",", "bHigh_", ",", "bLow_", ",", "LowOrder_"}], "}"}], 
     ",", "AbsTol_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"t_", ",", "y_", ",", "h_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"s", "=", 
       RowBox[{"Length", "[", "bHigh", "]"}]}], ",", "yHigh", ",", "yLow", 
      ",", "Err", ",", 
      RowBox[{"\[Gamma]", "=", "0.9"}], ",", "\[Alpha]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "[", "1", "]"}], "=", 
      RowBox[{"f", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "i", "]"}], "=", 
        RowBox[{"f", "[", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], " ", 
              RowBox[{"k", "[", "j", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "s"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yHigh", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "bHigh", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yLow", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "bLow", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Error", " ", "\[TildeTilde]"}], "||", 
        RowBox[{"yHigh", "-", "yLow"}], "||"}], "=", 
       RowBox[{"C", " ", 
        SuperscriptBox["h", 
         RowBox[{"LowOrder", "+", "1"}]]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Err", "=", 
      RowBox[{"Norm", "[", 
       RowBox[{"yHigh", "-", "yLow"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"\[Gamma]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["AbsTol", "Err"], ")"}], 
        FractionBox["1", 
         RowBox[{"LowOrder", "+", "1"}]]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"if", " ", "Err"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"C", " ", 
         SuperscriptBox["h", 
          RowBox[{"p", "+", "1"}]], " ", "then", " ", "C", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Alpha]", " ", "h"}], ")"}], 
          RowBox[{"p", "+", "1"}]]}], "=", " ", 
        RowBox[{"AbsTol", " ", "if", " ", Cell[TextData[{
          "\[Alpha] = ",
          Cell[BoxData[
           FormBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"AbsTol", "/", "Err"}], ")"}], 
             FractionBox["1", 
              RowBox[{"p", "+", "1"}]]], TraditionalForm]],
           FormatType->TraditionalForm,ExpressionUUID->
           "2ba9b07a-6ea3-4fe2-a4bb-dd70ea931574"]
         }],ExpressionUUID->"52a8338f-b521-443a-87bf-b37871fb2dae"]}]}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"(", 
        RowBox[{"frequently", " ", "0.9"}], ")"}], " ", "is", " ", "a", " ", 
       "safety", " ", 
       RowBox[{"factor", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "If", " ", Cell[
       "Err < AbsTol",ExpressionUUID->"4e1dcea1-01ee-43b7-b3f2-4c41bcc65bf3"],
        " ", "take", " ", "step", " ", "and", " ", "estimate", " ", "how", 
       " ", "big", " ", "the", " ", "next", " ", "step", " ", "can", " ", 
       "be"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "If", " ", Cell[
       "Err > AbsTol",ExpressionUUID->"c3d0309a-4e05-40fa-b0c3-9177236f2e97"],
        " ", "skip", " ", "step", " ", "and", " ", "try", " ", "again", " ", 
       "with", " ", "a", " ", "smaller", " ", "step"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", " ", 
      RowBox[{
       RowBox[{"Err", "<", "AbsTol"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "+", "h"}], ",", " ", "yHigh", ",", 
         RowBox[{"\[Alpha]", " ", "h"}]}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "y", ",", 
         RowBox[{"\[Alpha]", " ", "h"}]}], " ", "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9708198858525887`*^9, 3.970819967662645*^9}, {
   3.970820023286182*^9, 3.970820157006577*^9}, {3.970820216774482*^9, 
   3.9708203092944946`*^9}, {3.9708203460117426`*^9, 
   3.9708203478836727`*^9}, {3.970820752262429*^9, 3.9708207525026093`*^9}, {
   3.9708226064159355`*^9, 3.9708226291525145`*^9}, {3.9708227341744013`*^9, 
   3.970822912927661*^9}, {3.9708230725201817`*^9, 3.9708234671461554`*^9}, {
   3.970823502016512*^9, 3.970823684937579*^9}, {3.9708241434864464`*^9, 
   3.970824157949026*^9}, {3.970824244642497*^9, 3.970824247393689*^9}, 
   3.970824675977628*^9},ExpressionUUID->"bcf6e564-1170-4aa9-8375-\
e52c7f70ec50"],

Cell["The original RKF45 adaptive scheme is ", "Text",
 CellChangeTimes->{{3.970821364737235*^9, 3.970821380733389*^9}, {
  3.9708236996899605`*^9, 
  3.9708237190561123`*^9}},ExpressionUUID->"5eaaaa3f-7177-4877-bcb8-\
505bc390df87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"RKF45", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"0", "0", "0", "0", "0", "0"},
        {
         FractionBox["1", "4"], "0", "0", "0", "0", "0"},
        {
         FractionBox["3", "32"], 
         FractionBox["9", "32"], "0", "0", "0", "0"},
        {
         FractionBox["1932", "2197"], 
         FractionBox[
          RowBox[{"-", "7200"}], "2197"], 
         FractionBox["7296", "2197"], "0", "0", "0"},
        {
         FractionBox["439", "216"], 
         RowBox[{"-", "8"}], 
         FractionBox["3680", "513"], 
         FractionBox[
          RowBox[{"-", "845"}], "4104"], "0", "0"},
        {
         FractionBox[
          RowBox[{"-", "8"}], "27"], "2", 
         FractionBox[
          RowBox[{"-", "3544"}], "2565"], 
         FractionBox["1859", "4104"], 
         FractionBox[
          RowBox[{"-", "11"}], "40"], "0"}
       }], "\[NoBreak]", ")"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["6", "135"], ",", "0", ",", 
       FractionBox["6656", "12825"], ",", 
       FractionBox["28561", "56430"], ",", 
       FractionBox[
        RowBox[{"-", "9"}], "50"], ",", 
       FractionBox["2", "55"]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["25", "216"], ",", "0", ",", 
       FractionBox["1408", "2565"], ",", 
       FractionBox["2197", "4104"], ",", 
       FractionBox[
        RowBox[{"-", "1"}], "5"], ",", "0"}], "}"}], ",", "4"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DormandOrbit", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Mu]", "=", 
        RowBox[{"1", "/", "82.45"}]}], ",", "de", ",", "dm"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"p163", " ", "Dormand"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"de", "=", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Mu]"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"]}]]}], ";", " ", 
      RowBox[{"dm", "=", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Mu]"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"2", " ", "vy"}], " ", "+", "x", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
          FractionBox[
           RowBox[{"x", "+", "\[Mu]"}], 
           SuperscriptBox["de", "3"]]}], "-", 
         RowBox[{"\[Mu]", " ", 
          FractionBox[
           RowBox[{"x", "-", "1", "+", "\[Mu]"}], 
           SuperscriptBox["dm", "3"]]}]}], ",", "\[IndentingNewLine]", 
