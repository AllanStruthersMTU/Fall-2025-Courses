Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExplicitRKFixedhStep", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"A_", ",", "b_"}], "}"}], ",", "h_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"t_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"s", "=", 
       RowBox[{"Length", "[", "b", "]"}]}], ",", "yNew"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "[", "1", "]"}], "=", 
      RowBox[{"f", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "i", "]"}], "=", 
        RowBox[{"f", "[", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], " ", 
              RowBox[{"k", "[", "j", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "s"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yNew", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "+", "h"}], ",", " ", "yNew"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9708198858525887`*^9, 3.970819967662645*^9}, {
  3.970820023286182*^9, 3.970820157006577*^9}, {3.970820216774482*^9, 
  3.9708203092944946`*^9}, {3.9708203460117426`*^9, 3.9708203478836727`*^9}, {
  3.970820752262429*^9, 3.9708207525026093`*^9}},
