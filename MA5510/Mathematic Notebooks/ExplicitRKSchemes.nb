Notebook[{

Cell[CellGroupData[{
Cell["RK Implementation", "Title",
 CellChangeTimes->{{3.9648588100134473`*^9, 3.964858825018669*^9}, {
  3.9651175705012517`*^9, 3.965117581600165*^9}, {3.9658135999230127`*^9, 
  3.9658136046261387`*^9}, {3.9663473772906404`*^9, 3.966347399460182*^9}, {
  3.9688409144049745`*^9, 3.9688409188514566`*^9}, {3.9690077688109226`*^9, 
  3.969007780156148*^9}, {3.969097394231593*^9, 3.969097423161996*^9}, {
  3.970819795413167*^9, 
  3.970819805837791*^9}},ExpressionUUID->"f2f44f3d-e8ae-40dd-8c67-\
f1d81c252435"],

Cell[TextData[{
 "RK schemes for autonomous ODEs are defined by the Butcher matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0b659ea-e1a9-49ed-8723-f96c25d43323"],
 " and one or two b vectors. Fixed step size schemes have one vector b and \
variable step-size schemes have two vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "high"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c344d68-bfd7-423c-afc8-67efc123a46f"],
 " which advances the scheme and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "low"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75ec9e96-a11d-4eba-a9ad-afe6cbaaef85"],
 " that is used to estimate error and choose the step size"
}], "Text",
 CellChangeTimes->{{3.9664138014042187`*^9, 3.966413847066848*^9}, {
   3.9664138784710813`*^9, 3.966413912153821*^9}, 3.9664139656348624`*^9, {
   3.9664167901227913`*^9, 3.9664167925198135`*^9}, {3.9688409648276205`*^9, 
   3.9688409753869257`*^9}, {3.9690077941451907`*^9, 3.969007871599885*^9}, {
   3.9690974302393265`*^9, 3.9690976333423014`*^9}, {3.9708198167417927`*^9, 
   3.9708198762775135`*^9}, {3.9708199750627046`*^9, 
   3.9708200186860094`*^9}, {3.9708212371031485`*^9, 
   3.970821333670323*^9}},ExpressionUUID->"0145254b-3404-4ad8-b5fb-\
09968edad919"],

Cell[CellGroupData[{

Cell["Fixed Step Size.", "Subsection",
 CellChangeTimes->{{3.970822568374402*^9, 
  3.97082257775103*^9}},ExpressionUUID->"360c4e3f-f154-49ac-85eb-\
19fa8411f09f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExplicitRKFixedhStep", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"A_", ",", "b_"}], "}"}], ",", "h_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"t_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"s", "=", 
       RowBox[{"Length", "[", "b", "]"}]}], ",", "yNew"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "[", "1", "]"}], "=", 
      RowBox[{"f", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", "i", "]"}], "=", 
        RowBox[{"f", "[", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], " ", 
              RowBox[{"k", "[", "j", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "s"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yNew", "=", 
      RowBox[{"y", "+", 
       RowBox[{"h", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], " ", 
           RowBox[{"k", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "s"}], "}"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "+", "h"}], ",", " ", "yNew"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9708198858525887`*^9, 3.970819967662645*^9}, {
  3.970820023286182*^9, 3.970820157006577*^9}, {3.970820216774482*^9, 
  3.9708203092944946`*^9}, {3.9708203460117426`*^9, 3.9708203478836727`*^9}, {
  3.970820752262429*^9, 3.9708207525026093`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"dd0b4135-0366-4eaf-ad36-448e2a854769"],

Cell["The original RK schemes were fixed step size. ", "Text",
 CellChangeTimes->{{3.970821364737235*^9, 3.970821380733389*^9}, {
  3.970822639102185*^9, 
  3.9708226399105716`*^9}},ExpressionUUID->"05120d50-a7ff-40ca-a04a-\
de55cb48a9d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClassicRK4", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", "0", "0", "0"},
          {
           FractionBox["1", "2"], "0", "0", "0"},
          {"0", 
           FractionBox["1", "2"], "0", "0"},
          {"0", "0", "1", "0"}
         }], "\[NoBreak]", ")"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "6"], ",", 
         FractionBox["1", "3"], ",", 
         FractionBox["1", "3"], ",", 
         FractionBox["1", "6"]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ThreeEightRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", "0", "0", "0"},
          {
           FractionBox["1", "3"], "0", "0", "0"},
          {
           RowBox[{"-", 
            FractionBox["1", "3"]}], "1", "0", "0"},
          {"1", 
           RowBox[{"-", "1"}], "1", "0"}
         }], "\[NoBreak]", ")"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "8"], ",", 
         FractionBox["3", "8"], ",", 
         FractionBox["3", "8"], ",", 
         FractionBox["1", "8"]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DormandOrbit", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Mu]", "=", 
         RowBox[{"1", "/", "82.45"}]}], ",", "de", ",", "dm"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"p163", " ", "Dormand"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"de", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "+", "\[Mu]"}], ")"}], "2"], "+", 
          SuperscriptBox["y", "2"]}]]}], ";", " ", 
       RowBox[{"dm", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "1", "+", "\[Mu]"}], ")"}], "2"], "+", 
          SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{"2", " ", "vy"}], " ", "+", "x", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
           FractionBox[
            RowBox[{"x", "+", "\[Mu]"}], 
            SuperscriptBox["de", "3"]]}], "-", 
          RowBox[{"\[Mu]", " ", 
           FractionBox[
            RowBox[{"x", "-", "1", "+", "\[Mu]"}], 
            SuperscriptBox["dm", "3"]]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "vx"}], " ", "+", "y", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
           FractionBox["y", 
            SuperscriptBox["de", "3"]]}], "-", 
          RowBox[{"\[Mu]", " ", 
           FractionBox["y", 
            SuperscriptBox["dm", "3"]]}]}]}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y0", "=", 
     RowBox[{"{", 
      RowBox[{"1.2", ",", "0", ",", "0", ",", 
       RowBox[{"-", "1.049357509830320"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t0", "=", "0"}], ";", " ", 
    RowBox[{"TMax", "=", "6.192169331319640"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "2000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"TMax", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ySol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"DormandOrbit", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MmaPic", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ySol", "[", "t", "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RK4CData", "=", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{"ExplicitRKFixedhStep", "[", 
        RowBox[{"DormandOrbit", ",", "ClassicRK4", ",", "h"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "y0"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RK38Data", "=", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{"ExplicitRKFixedhStep", "[", 
        RowBox[{"DormandOrbit", ",", "ThreeEightRule", ",", "h"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "y0"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"MmaPic", ",", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RK4CData", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "2", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{"RK38Data", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "2", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}]}], 
       "}"}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.970820376671749*^9, 3.9708207455744724`*^9}, {
  3.9708207761028395`*^9, 3.9708211837269063`*^9}, {3.9708213910781093`*^9, 
  3.970821443471171*^9}, {3.9708215313749046`*^9, 3.9708216642228336`*^9}, {
