  3.9708226399105716`*^9}},ExpressionUUID->"05120d50-a7ff-40ca-a04a-\
de55cb48a9d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClassicRK4", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", "0", "0", "0"},
          {
           FractionBox["1", "2"], "0", "0", "0"},
          {"0", 
           FractionBox["1", "2"], "0", "0"},
          {"0", "0", "1", "0"}
         }], "\[NoBreak]", ")"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "6"], ",", 
         FractionBox["1", "3"], ",", 
         FractionBox["1", "3"], ",", 
         FractionBox["1", "6"]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ThreeEightRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", "0", "0", "0"},
          {
           FractionBox["1", "3"], "0", "0", "0"},
          {
           RowBox[{"-", 
            FractionBox["1", "3"]}], "1", "0", "0"},
          {"1", 
           RowBox[{"-", "1"}], "1", "0"}
         }], "\[NoBreak]", ")"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "8"], ",", 
         FractionBox["3", "8"], ",", 
         FractionBox["3", "8"], ",", 
         FractionBox["1", "8"]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DormandOrbit", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Mu]", "=", 
         RowBox[{"1", "/", "82.45"}]}], ",", "de", ",", "dm"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"p163", " ", "Dormand"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"de", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "+", "\[Mu]"}], ")"}], "2"], "+", 
          SuperscriptBox["y", "2"]}]]}], ";", " ", 
       RowBox[{"dm", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "1", "+", "\[Mu]"}], ")"}], "2"], "+", 
          SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{"2", " ", "vy"}], " ", "+", "x", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
           FractionBox[
            RowBox[{"x", "+", "\[Mu]"}], 
            SuperscriptBox["de", "3"]]}], "-", 
          RowBox[{"\[Mu]", " ", 
           FractionBox[
            RowBox[{"x", "-", "1", "+", "\[Mu]"}], 
            SuperscriptBox["dm", "3"]]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "vx"}], " ", "+", "y", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
           FractionBox["y", 
            SuperscriptBox["de", "3"]]}], "-", 
          RowBox[{"\[Mu]", " ", 
           FractionBox["y", 
            SuperscriptBox["dm", "3"]]}]}]}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y0", "=", 
     RowBox[{"{", 
      RowBox[{"1.2", ",", "0", ",", "0", ",", 
       RowBox[{"-", "1.049357509830320"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t0", "=", "0"}], ";", " ", 
    RowBox[{"TMax", "=", "6.192169331319640"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "3000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"TMax", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ySol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"DormandOrbit", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MmaPic", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ySol", "[", "t", "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RK4CData", "=", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{"ExplicitRKFixedhStep", "[", 
        RowBox[{"DormandOrbit", ",", "ClassicRK4", ",", "h"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "y0"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RK38Data", "=", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{"ExplicitRKFixedhStep", "[", 
        RowBox[{"DormandOrbit", ",", "ThreeEightRule", ",", "h"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "y0"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"MmaPic", ",", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RK4CData", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"RK38Data", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<RK4\>\"", ",", "\"\<RK38\>\""}], "}"}]}]}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.970820376671749*^9, 3.9708207455744724`*^9}, {
   3.9708207761028395`*^9, 3.9708211837269063`*^9}, {3.9708213910781093`*^9, 
