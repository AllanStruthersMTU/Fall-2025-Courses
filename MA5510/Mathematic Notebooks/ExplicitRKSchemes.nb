Cell["The original RKF45 adaptive scheme is ", "Text",
 CellChangeTimes->{{3.970821364737235*^9, 3.970821380733389*^9}, {
  3.9708236996899605`*^9, 
  3.9708237190561123`*^9}},ExpressionUUID->"5eaaaa3f-7177-4877-bcb8-\
505bc390df87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"RKF45", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"0", "0", "0", "0", "0", "0"},
        {
         FractionBox["1", "4"], "0", "0", "0", "0", "0"},
        {
         FractionBox["3", "32"], 
         FractionBox["9", "32"], "0", "0", "0", "0"},
        {
         FractionBox["1932", "2197"], 
         FractionBox[
          RowBox[{"-", "7200"}], "2197"], 
         FractionBox["7296", "2197"], "0", "0", "0"},
        {
         FractionBox["439", "216"], 
         RowBox[{"-", "8"}], 
         FractionBox["3680", "513"], 
         FractionBox[
          RowBox[{"-", "845"}], "4104"], "0", "0"},
        {
         FractionBox[
          RowBox[{"-", "8"}], "27"], "2", 
         FractionBox[
          RowBox[{"-", "3544"}], "2565"], 
         FractionBox["1859", "4104"], 
         FractionBox[
          RowBox[{"-", "11"}], "40"], "0"}
       }], "\[NoBreak]", ")"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["16", "135"], ",", "0", ",", 
       FractionBox["6656", "12825"], ",", 
       FractionBox["28561", "56430"], ",", 
       FractionBox[
        RowBox[{"-", "9"}], "50"], ",", 
       FractionBox["2", "55"]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["25", "216"], ",", "0", ",", 
       FractionBox["1408", "2565"], ",", 
       FractionBox["2197", "4104"], ",", 
       FractionBox[
        RowBox[{"-", "1"}], "5"], ",", "0"}], "}"}], ",", "4"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DormandOrbit", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Mu]", "=", 
        RowBox[{"1", "/", "82.45"}]}], ",", "de", ",", "dm"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"p163", " ", "Dormand"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"de", "=", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Mu]"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"]}]]}], ";", " ", 
      RowBox[{"dm", "=", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Mu]"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"2", " ", "vy"}], " ", "+", "x", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
          FractionBox[
           RowBox[{"x", "+", "\[Mu]"}], 
           SuperscriptBox["de", "3"]]}], "-", 
         RowBox[{"\[Mu]", " ", 
          FractionBox[
           RowBox[{"x", "-", "1", "+", "\[Mu]"}], 
           SuperscriptBox["dm", "3"]]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "vx"}], " ", "+", "y", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
          FractionBox["y", 
           SuperscriptBox["de", "3"]]}], "-", 
         RowBox[{"\[Mu]", " ", 
          FractionBox["y", 
           SuperscriptBox["dm", "3"]]}]}]}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1.2", ",", "0", ",", "0", ",", 
     RowBox[{"-", "1.049357509830320"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "0"}], ";", " ", 
  RowBox[{"TMax", "=", "6.192169331319640"}], ";", " ", 
  RowBox[{"h0", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"DormandOrbit", "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MmaPic", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ySol", "[", "t", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RKF45Data", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{"ExplicitRKAdaptiveStep", "[", 
      RowBox[{"DormandOrbit", ",", "RKF45", ",", 
       SuperscriptBox["10", 
        RowBox[{"-", "4"}]]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "y0", ",", "h0"}], "}"}], ",", "120"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"MmaPic", ",", " ", 
   RowBox[{"ListPlot", "[", " ", 
    RowBox[{"RKF45Data", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "2", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], "]"}], 
   ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hs", "=", 
   RowBox[{"RKF45Data", "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "3"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
