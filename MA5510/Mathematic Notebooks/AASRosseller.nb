             RowBox[{"{", 
              RowBox[{
               RowBox[{"y", "[", "t", "]"}], ",", 
               RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}]}]}], 
          "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     "]"}], "\[LeftDoubleBracket]", 
