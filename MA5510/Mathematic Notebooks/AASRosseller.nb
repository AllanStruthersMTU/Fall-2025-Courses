             RowBox[{"y", "[", "t", "]"}], ",", 
             RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}]}]}], 
        "\[IndentingNewLine]", "}"}]}]}], "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
