Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"df", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"five", " ", "times", " ", "around", " ", "and", " ", "stop"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "100"}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3"}], ",", 
     RowBox[{"-", "4"}], ",", "10"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"0.2", ",", "0.2", ",", "3.81"}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nMax", "=", "9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", "tEnd"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "TMax"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"Quiet", "[", 
    RowBox[{"ySol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"f", "[", "p", "]"}], "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         
         RowBox[{
          RowBox[{
           RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"df", "[", "p", "]"}], "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
           RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"J", "[", "0", "]"}], "==", 
          RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
        "\[IndentingNewLine]", "}"}], ",", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"AccuracyGoal", "->", "10"}], ","}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"StartingStepSize", "->", "0.06"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"Method", "->", "\"\<ExplicitRungeKutta\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Event\>\"", ":>", 
           RowBox[{
            RowBox[{
             RowBox[{"f", "[", "p", "]"}], "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", "3",
             "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Direction\>\"", "->", 
           RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<EventAction\>\"", ":>", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"n", "++"}], ">=", "nMax"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"yVal", "=", 
               RowBox[{"y", "[", "t", "]"}]}], ";", 
              RowBox[{"tEnd", "=", "t"}], ";", "\"\<StopIntegration\>\""}]}], 
            "]"}]}]}], "\[IndentingNewLine]", "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}], ";"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"ySol", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", " ", ",", "tEnd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "->", "1000"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ySol", "[", "t", "]"}], "\[LeftDoubleBracket]", "3", 
    "\[RightDoubleBracket]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", " ", ",", "tEnd"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
