Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"w", "=", "1"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "is", " ", "the", " ", "winding", " ", "#2", " ", "parametrs",
     " ", "we", " ", "found"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"df", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "yVal"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<Event\>\"", ":>", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", "p", "]"}], "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", "3", 
          "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<Direction\>\"", "->", 
         RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<EventAction\>\"", ":>", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n", "++"}], ">", "w"}], ",", 
           RowBox[{"\"\<StopIntegration\>\"", ";", 
            RowBox[{"tEnd", "=", "t"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "n", "\[IndentingNewLine]", 
