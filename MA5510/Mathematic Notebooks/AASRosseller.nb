          RowBox[{"f", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{
           RowBox[{"df", "[", "p", "]"}], "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
          RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"J", "[", "0", "]"}], "==", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "\[IndentingNewLine]",
        "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Event\>\"", ":>", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", "p", "]"}], "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", "3", 
           "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Direction\>\"", "->", 
          RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<EventAction\>\"", ":>", 
          RowBox[{"Sow", "[", 
           RowBox[{"{", 
