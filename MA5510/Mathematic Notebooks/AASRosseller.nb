67b0cc2e8f2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StepRoundSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "y0_", ",", "DyTol_", ",", " ", 
    "MaxCounts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "0"}], ",", "y", ",", "J", ",", "t", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "4"]}], ",", "yOut", ",", 
      RowBox[{"tOut", "=", "0.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
         "\[IndentingNewLine]", "}"}], ",", "y", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Event\>\"", ":>", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}], "\[LeftDoubleBracket]", 
             "3", "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Direction\>\"", "->", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<EventAction\>\"", ":>", 
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sow", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "++"}], ",", "t", ",", 
                 RowBox[{"y", "[", "t", "]"}], ",", 
                 RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"Or", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"y", "[", "t", "]"}], "-", "y0"}], "]"}], "<", 
                   "DyTol"}], ",", " ", 
                  RowBox[{"n", ">", "MaxCounts"}]}], "]"}], 
                ",", "\"\<StopIntegration\>\""}], "]"}]}], 
             "\[IndentingNewLine]", ")"}]}]}], "\[IndentingNewLine]", 
          "}"}]}]}], "]"}], "]"}], "\[LeftDoubleBracket]", 
     RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
