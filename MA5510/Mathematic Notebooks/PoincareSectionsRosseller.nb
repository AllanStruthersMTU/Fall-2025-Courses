   3.971864047910971*^9, 3.9718640528801584`*^9}, {3.9718732329417534`*^9, 
   3.971873260750226*^9}},
 CellLabel->
  "In[475]:=",ExpressionUUID->"ff47cbae-7042-4b94-9409-f78b6cb5d329"],

