Cell["\<\
In words.  There is an obvious Limit Cycle which looks as though it goes \
round twice (for b=3.2) before it repeats.  The Poincare section will lets us \
give a careful definition of  going round 2 or 3 or 4 times. \
\>", "Text",
 CellChangeTimes->{{3.9718612022641573`*^9, 3.9718612686729336`*^9}, {
  3.971861360707716*^9, 3.971861400292994*^9}, {3.971861451437546*^9, 
  3.9718614553813148`*^9}, {3.971872298174425*^9, 
  3.9718723100646048`*^9}},ExpressionUUID->"f9db2efd-a0ab-4bdf-a475-\
c75919582800"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rosseler System and Section Computation", "Section",
 CellChangeTimes->{{3.9718581951623497`*^9, 3.9718582138458548`*^9}, {
  3.9718590464601407`*^9, 3.9718590482665725`*^9}, {3.971859088168677*^9, 
  3.9718590909761457`*^9}},ExpressionUUID->"82575d36-be17-4c06-9695-\
bd070ac1800c"],

Cell["\<\
Computing the section points is pretty easy in Mathematica.  It may be \
substantially more complicated in other languages to compute the points \
accurately.  You need \[OpenCurlyDoubleQuote]dense output\
\[CloseCurlyDoubleQuote] of your ODE solver (accurate interpolation) \
integrated with a robust bracketing root finder.  \
\>", "Text",
 CellChangeTimes->{{3.971859124740505*^9, 
  3.971859254426858*^9}},ExpressionUUID->"efda3a5e-680c-4390-82c5-\
d56fd8b1271b"],

Cell[TextData[{
 "I am going to show the section going through the tops (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"z", "'"}], "[", "t", "]"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e4aae73-44c8-4b3d-a5d4-0389b9a217d0"],
 ") of all the curves when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", " ", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "733b92a2-ca35-4708-b992-0f1241870dc4"],
 ". You can see the points on the section below. "
}], "Text",
 CellChangeTimes->{{3.9718585430669518`*^9, 3.971858712431202*^9}, {
  3.971859024983863*^9, 3.971859038887788*^9}, {3.9718592821436534`*^9, 
  3.971859293996863*^9}, {3.9718724031104465`*^9, 
  3.9718724037040644`*^9}},ExpressionUUID->"37989078-d79d-4d64-964b-\
51c538a72ce2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"y", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "3.2"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PSections", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"x", "-", "c"}], ")"}]}]}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.1", ",", " ", "10"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "->", "50"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PData", "=", 
   RowBox[{
    RowBox[{"Reap", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ySol", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"f", "[", "p", "]"}], "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], 
          "\[IndentingNewLine]", "}"}], ",", "y", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<Event\>\"", ":>", 
             RowBox[{
              RowBox[{
               RowBox[{"y", "'"}], "[", "t", "]"}], "\[LeftDoubleBracket]", 
              "3", "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<EventAction\>\"", ":>", 
             RowBox[{"Sow", "[", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"y", "[", "t", "]"}]}], "}"}], "]"}]}]}], "}"}]}]}], 
        "]"}]}], ";"}], "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"2", ",", "1", ",", "All"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"PDots", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tt", ",", "xyz"}], "}"}], "=", 
          RowBox[{
          "PData", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Hue", "[", 
            RowBox[{"0.9", 
             RowBox[{"tt", "/", "TMax"}]}], "]"}], ",", 
           RowBox[{"Point", "[", "xyz", "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "PData", "]"}]}], "}"}]}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"Axes", "->", "True"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9718587165549855`*^9, 3.971858994082803*^9}, {
  3.9718593002703133`*^9, 3.97185930975921*^9}, {3.9718593561470947`*^9, 
