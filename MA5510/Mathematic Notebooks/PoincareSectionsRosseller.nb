  3.9718619859301205`*^9}},ExpressionUUID->"fd065fb4-4fe2-497b-8e9a-\
6530328338c1"],

Cell["\<\
It is worth while thinking about how to develop this code.  I would first \
build and check the ODE solver. \
\>", "Text",
 CellChangeTimes->{{3.971862356936762*^9, 3.9718624025414286`*^9}, {
  3.9718632274697795`*^9, 
  3.971863228510436*^9}},ExpressionUUID->"1066562e-a6df-4e54-be13-\
9a97cea59022"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RosselerFirstReturnDev", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"y0_", ",", "z0_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x0", " ", "=", 
       RowBox[{"c", "-", 
        RowBox[{"b", "/", "z0"}]}]}], ",", " ", 
      RowBox[{"TMax", "=", "100"}]}], " ", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NDSolveValue", "[", " ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"y", "[", "t", "]"}]}], "-", 
          RowBox[{"z", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", " ", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], " ", "+", " ", 
          RowBox[{"a", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"b", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], "-", "c"}], ")"}], 
           RowBox[{"z", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
        RowBox[{
         RowBox[{"z", "[", "0", "]"}], "==", "z0"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "3.7"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xSol", ",", "ySol", ",", "zSol"}], "}"}], "=", 
   RowBox[{
    RowBox[{"RosselerFirstReturnDev", "[", "p", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "3.21"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xSol", "[", "t", "]"}], ",", 
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"zSol", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "100"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", 
      SuperscriptBox["10", "3"]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"x", "-", "c"}], ")"}]}]}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.1", ",", " ", "10"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "->", "50"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.971861989158944*^9, 3.9718620415826592`*^9}, 
   3.971862079336488*^9, {3.971862138618873*^9, 3.97186232224046*^9}, {
