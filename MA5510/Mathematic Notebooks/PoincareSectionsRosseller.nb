Cell[TextData[{
 "The standard section to think about is either the vertical section ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b5b8183-167b-4204-9377-b213b49221d9"],
 " or the slightly more complicated section going through the tops (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"z", "'"}], "[", "t", "]"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e1b0f68-cd79-43a1-8671-41d1a8217adc"],
 ") of all the curves when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", " ", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4987ac86-520f-4b8f-b1d9-d017d8f4ebbe"],
 ". You can see the points on the section below. "
}], "Text",
 CellChangeTimes->{{3.9718585430669518`*^9, 3.971858712431202*^9}, {
  3.971859024983863*^9, 
  3.971859038887788*^9}},ExpressionUUID->"b5aae77c-8794-4e6e-af22-\
7b002c734459"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PSections", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "==", "y"}], ",", 
       RowBox[{
        RowBox[{"b", "+", 
         RowBox[{"z", 
          RowBox[{"(", 
           RowBox[{"x", "-", "c"}], ")"}]}]}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.1", ",", " ", "10"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "->", "50"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<(0, TMax)\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"PSections", ",", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotPoints", "->", "1000"}]}], "]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<(0, 0.1 TMax)\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"PSections", ",", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", " ", 
           RowBox[{"TMax", "/", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotPoints", "->", "1000"}]}], "]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<(0.9 TMax,TMax)\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"PSections", ",", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"0.9", "TMax"}], ",", " ", "TMax"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotPoints", "->", "1000"}]}], "]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9718587165549855`*^9, 3.971858994082803*^9}},
 CellLabel->
  "In[449]:=",ExpressionUUID->"9deaa241-c7fc-43d7-92bb-137af44fc0f6"],

