    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "3.7"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FirstReturnData", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{"RosselerFirstReturn", "[", "p", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3.21"}], "}"}], ",", "500"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
