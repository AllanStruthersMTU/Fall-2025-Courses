Cell["\<\
We need to decide how we want to look at these \[OpenCurlyDoubleQuote]section\
\[CloseCurlyDoubleQuote] points. The standard way is to think of a new \
discrete dynamical system defined for points on the surface that gives you \
back the next point the ODE orbit goes through on the surface.  This is \
called the first return map.  Again fairly easy to code in Mathematica.  \
\>", "Text",
 CellChangeTimes->{{3.971861465453226*^9, 3.971861483521206*^9}, {
  3.971861617792064*^9, 3.971861630442547*^9}, {3.971861793463976*^9, 
  3.9718619455648136`*^9}},ExpressionUUID->"d8cdb74b-42b1-4924-8388-\
06c1369b5d91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PData", "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}]], "Input",
 CellChangeTimes->{{3.971862687272213*^9, 3.971862693361184*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"c6c76a2d-375a-494b-915e-71f574d74eff"],

