Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RosselerFirstReturn", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"y0_", ",", "z0_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x0", " ", "=", 
       RowBox[{"c", "-", 
        RowBox[{"b", "/", "z0"}]}]}], ",", " ", 
      RowBox[{"TMax", "=", "100"}], ",", "tEnd", ",", "t", ",", "x", ",", "y",
       ",", "z"}], " ", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xSol", ",", "ySol", ",", "zSol"}], "}"}], "=", 
      RowBox[{"NDSolveValue", "[", " ", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}], "==", " ", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"y", "[", "t", "]"}]}], "-", 
            RowBox[{"z", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", " ", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], " ", "+", " ", 
            RowBox[{"a", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"b", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "-", "c"}], ")"}], 
             RowBox[{"z", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          RowBox[{
           RowBox[{"z", "[", "0", "]"}], "==", "z0"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Event\>\"", ":>", 
            RowBox[{
             RowBox[{"b", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"x", "[", "t", "]"}], "-", "c"}], ")"}], 
               RowBox[{"z", "[", "t", "]"}]}]}], "==", "0"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<Direction\>\"", "->", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<EventAction\>\"", ":>", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"tEnd", "=", "t"}], ";", "\"\<StopIntegration\>\""}], 
             ")"}]}]}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ySol", "[", "tEnd", "]"}], ",", 
       RowBox[{"zSol", "[", "tEnd", "]"}]}], "}"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.971861989158944*^9, 3.9718620415826592`*^9}, 
   3.971862079336488*^9, {3.971862138618873*^9, 3.97186232224046*^9}, {
