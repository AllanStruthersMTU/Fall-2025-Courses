Notebook[{

Cell[CellGroupData[{
Cell["Poincare Sections Rosseler ", "Title",
 CellChangeTimes->{{3.9648588100134473`*^9, 3.964858825018669*^9}, {
  3.9651175705012517`*^9, 3.965117581600165*^9}, {3.9658135999230127`*^9, 
  3.9658136046261387`*^9}, {3.9663473772906404`*^9, 3.966347399460182*^9}, {
  3.9688409144049745`*^9, 3.9688409188514566`*^9}, {3.97185802160294*^9, 
  3.9718580270771055`*^9}},ExpressionUUID->"f2f44f3d-e8ae-40dd-8c67-\
f1d81c252435"],

Cell["\<\
Just a reminder about the Rosseler System
 https://en.wikipedia.org/wiki/R%C3%B6ssler_attractor\
\>", "Text",
 CellChangeTimes->{{3.9664138014042187`*^9, 3.966413847066848*^9}, {
   3.9664138784710813`*^9, 3.966413912153821*^9}, 3.9664139656348624`*^9, {
   3.9664167901227913`*^9, 3.9664167925198135`*^9}, {3.9688409648276205`*^9, 
   3.9688409753869257`*^9}, {3.9690158570444593`*^9, 
   3.9690158662539797`*^9}},ExpressionUUID->"0145254b-3404-4ad8-b5fb-\
09968edad919"],

Cell[TextData[{
 "A reminder that a Poincare Section is a record of all the points \
(frequently going only one way) through an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ef30286-7fe6-433a-a6a5-bd0d65cc58ed"],
 " dimensional surface in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9bc0cb0a-61d6-42e5-a475-f509726dc494"],
 " the dimensional phase space of our ODE.  This is much clearer in a \
specific case.  We are doing the Rosseler system which has a three \
dimensional phase space.  "
}], "Text",
 CellChangeTimes->{{3.971858030740168*^9, 
  3.971858172267823*^9}},ExpressionUUID->"c94c56b2-94dd-4899-9218-\
63038d01fe38"],

Cell[CellGroupData[{

Cell["Rosseler System and Section Idea", "Section",
 CellChangeTimes->{{3.9718581951623497`*^9, 3.9718582138458548`*^9}, {
  3.9718590464601407`*^9, 
  3.9718590482665725`*^9}},ExpressionUUID->"7253e3db-ad6b-4493-baa9-\
fb2af09750c9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "234"}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3"}], ",", 
     RowBox[{"-", "4"}], ",", "5"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "3.81"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "\[IndentingNewLine]", 
      "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<(0, TMax)\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotPoints", "->", "1000"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<(0, 0.1 TMax)\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", 
         RowBox[{"TMax", "/", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotPoints", "->", "1000"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<(0.9 TMax,TMax)\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"0.9", "TMax"}], ",", " ", "TMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotPoints", "->", "1000"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9718582241523952`*^9, 3.971858525237077*^9}, {
   3.971859106566011*^9, 3.971859106956705*^9}, {3.9718712798146305`*^9, 
