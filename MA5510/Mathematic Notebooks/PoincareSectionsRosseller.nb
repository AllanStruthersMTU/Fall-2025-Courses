Cell["\<\
Then I would add in the event locator that stops the integration when it hits \
the section again.  I would code this in the \[OpenCurlyDoubleQuote]primitive\
\[CloseCurlyDoubleQuote] variables \[OpenCurlyDoubleQuote]x, y, z\
\[CloseCurlyDoubleQuote] rather than the derivatives. I would make sure this \
was doing the right thing by plotting it.  \
\>", "Text",
 CellChangeTimes->{{3.9718624284534597`*^9, 3.971862502077506*^9}, {
  3.971863656426306*^9, 3.9718636673066125`*^9}, {3.971863706010289*^9, 
  3.971863716420534*^9}},ExpressionUUID->"aff43ea6-b82c-41b0-93e4-\
38c6a8d74afd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RosselerFirstReturnDev", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"y0_", ",", "z0_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x0", " ", "=", 
       RowBox[{"c", "-", 
        RowBox[{"b", "/", "z0"}]}]}], ",", " ", 
      RowBox[{"TMax", "=", "100"}]}], " ", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NDSolveValue", "[", " ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"y", "[", "t", "]"}]}], "-", 
          RowBox[{"z", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", " ", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], " ", "+", " ", 
          RowBox[{"a", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"b", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], "-", "c"}], ")"}], 
           RowBox[{"z", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
        RowBox[{
         RowBox[{"z", "[", "0", "]"}], "==", "z0"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Event\>\"", ":>", 
          RowBox[{
           RowBox[{"b", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "-", "c"}], ")"}], 
             RowBox[{"z", "[", "t", "]"}]}]}], "==", "0"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<Direction\>\"", "->", 
          RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<EventAction\>\"", ":>", "\"\<StopIntegration\>\""}]}], 
        "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "3.7"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xSol", ",", "ySol", ",", "zSol"}], "}"}], "=", 
   RowBox[{
    RowBox[{"RosselerFirstReturnDev", "[", "p", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3.21"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", 
   RowBox[{
    RowBox[{"xSol", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xSol", "[", "t", "]"}], ",", 
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"zSol", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", 
      SuperscriptBox["10", "3"]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"x", "-", "c"}], ")"}]}]}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.1", ",", " ", "10"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "->", "50"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"StringForm", "[", 
     RowBox[{"\"\<1st Returb 2 = ``\>\"", ",", " ", "TMax"}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.971861989158944*^9, 3.9718620415826592`*^9}, 
   3.971862079336488*^9, {3.971862138618873*^9, 3.97186232224046*^9}, {
   3.9718625099039173`*^9, 3.9718625185538735`*^9}, {3.9718625518753595`*^9, 
   3.971862593477388*^9}, {3.971862648330187*^9, 3.9718626653645973`*^9}, {
   3.971862713040123*^9, 3.9718628538564835`*^9}, {3.9718630507309337`*^9, 
